<UserControl
    x:Class="ErhioLab.Craft.Launcher.Controls.AccentColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 色板按钮共享外观. -->
        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Swatch"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="2"
                            CornerRadius="7" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton
            x:Name="PickerButton"
            Width="142"
            Height="34"
            HorizontalAlignment="Left"
            Background="{DynamicResource InkRaisedBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            Cursor="Hand"
            Foreground="{DynamicResource TextBrush}">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Border
                    x:Name="CurrentSwatch"
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    CornerRadius="3" />
                <TextBlock VerticalAlignment="Center" FontSize="11" Text="选择主题色" />
            </StackPanel>
        </ToggleButton>

        <Popup
            AllowsTransparency="True"
            IsOpen="{Binding IsChecked, ElementName=PickerButton, Mode=TwoWay}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=PickerButton}"
            StaysOpen="False">
            <Border
                Width="282"
                Margin="0,6,0,0"
                Padding="16"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="9"
                TextElement.Foreground="{DynamicResource TextBrush}">
                <StackPanel>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="选择主题色" />
                    <TextBlock
                        Margin="0,4,0,12"
                        FontSize="11"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="预设颜色" />
                    <WrapPanel>
                        <Button
                            Tag="#80CEFF"
                            Background="#80CEFF"
                            Click="PresetColor_Click"
                            Style="{StaticResource ColorSwatchStyle}" />
                        <Button
                            Tag="#7BA8FF"
                            Background="#7BA8FF"
                            Click="PresetColor_Click"
                            Style="{StaticResource ColorSwatchStyle}" />
                        <Button
                            Tag="#A991FF"
                            Background="#A991FF"
                            Click="PresetColor_Click"
                            Style="{StaticResource ColorSwatchStyle}" />
                        <Button
                            Tag="#F08BB5"
                            Background="#F08BB5"
                            Click="PresetColor_Click"
                            Style="{StaticResource ColorSwatchStyle}" />
                        <Button
                            Tag="#77D7BF"
                            Background="#77D7BF"
                            Click="PresetColor_Click"
                            Style="{StaticResource ColorSwatchStyle}" />
                        <Button
                            Tag="#F1B86E"
                            Background="#F1B86E"
                            Click="PresetColor_Click"
                            Style="{StaticResource ColorSwatchStyle}" />
                    </WrapPanel>
                    <Border Height="1" Margin="0,13,0,12" Background="{DynamicResource LineSoftBrush}" />
                    <TextBlock FontSize="11" Text="自定义颜色" />
                    <Border Height="9" Margin="0,11,0,0" CornerRadius="4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFFF0000" Offset="0" />
                                <GradientStop Color="#FFFFFF00" Offset="0.167" />
                                <GradientStop Color="#FF00FF00" Offset="0.333" />
                                <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                <GradientStop Color="#FF0000FF" Offset="0.667" />
                                <GradientStop Color="#FFFF00FF" Offset="0.833" />
                                <GradientStop Color="#FFFF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Slider x:Name="HueSlider" Maximum="360" ValueChanged="PickerSlider_ValueChanged" />
                    <TextBlock Margin="0,6,0,0" FontSize="11" Text="饱和度" />
                    <Slider x:Name="SaturationSlider" Maximum="100" ValueChanged="PickerSlider_ValueChanged" />
                    <TextBlock Margin="0,6,0,0" FontSize="11" Text="亮度" />
                    <Slider x:Name="BrightnessSlider" Maximum="100" ValueChanged="PickerSlider_ValueChanged" />
                    <Border Height="1" Margin="0,12,0,12" Background="{DynamicResource LineSoftBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="PreviewSwatch"
                            Width="32"
                            Height="32"
                            Margin="0,0,10,0"
                            CornerRadius="5" />
                        <TextBox
                            x:Name="HexInput"
                            Grid.Column="1"
                            Height="32"
                            Padding="8,5"
                            VerticalContentAlignment="Center"
                            Background="{DynamicResource InkRaisedBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="12"
                            Foreground="{DynamicResource TextBrush}"
                            KeyDown="HexInput_KeyDown"
                            TextChanged="HexInput_TextChanged" />
                    </Grid>
                    <TextBlock
                        x:Name="HexErrorText"
                        Margin="0,6,0,0"
                        FontSize="11"
                        Foreground="#FFE5484D"
                        Text="请输入 #RRGGBB 格式."
                        Visibility="Collapsed" />
                    <Button
                        Height="32"
                        Margin="0,11,0,0"
                        Click="ApplyColor_Click"
                        Content="应用颜色"
                        Style="{StaticResource SecondaryActionStyle}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
