<UserControl
    x:Class="ErhioLab.Craft.Launcher.Controls.LocalItemInfoCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    Focusable="False">
    <Border
        Padding="16,12"
        Style="{StaticResource PanelCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <controls:IconButton
                    DockPanel.Dock="Right"
                    Icon="{x:Static icons:LauncherIcons.Close}"
                    ToolTip="{DynamicResource I18n.common.closeLocalInfo}"
                    Click="Close_Click" />
                <TextBlock
                    Text="{Binding Heading, ElementName=Root}"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ScrollViewer
                Grid.Row="1"
                Margin="0,6,0,0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <ContentPresenter
                    VerticalAlignment="Top"
                    Content="{Binding Body, ElementName=Root}" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
