<UserControl
    x:Class="ErhioLab.Craft.Launcher.Controls.LocalItemSelectionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    Focusable="False">
    <controls:AnimatedReveal
        x:Name="SelectionReveal">
        <Border
            Padding="16,12"
            Margin="0,12,0,0"
            Style="{StaticResource PanelCardStyle}">
            <DockPanel>
                <TextBlock
                    x:Name="SelectionText"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AccentBrush}" />
                <WrapPanel
                    HorizontalAlignment="Right">
                    <Button
                        x:Name="LocalInfoButton"
                        Content="{DynamicResource I18n.common.localInfo}"
                        Click="LocalInfo_Click"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Visibility="Collapsed"
                        Margin="8,0,0,0" />
                    <Button
                        Content="{DynamicResource I18n.mods.enable}"
                        Click="Enable_Click"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Margin="8,0,0,0" />
                    <Button
                        Content="{DynamicResource I18n.mods.disable}"
                        Click="Disable_Click"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Margin="8,0,0,0" />
                    <Button
                        Content="{DynamicResource I18n.mods.delete}"
                        Click="Delete_Click"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Margin="8,0,0,0" />
                    <Button
                        Content="{DynamicResource I18n.mods.deselect}"
                        Click="Deselect_Click"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Margin="8,0,0,0" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </controls:AnimatedReveal>
</UserControl>
