<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Launch.VersionPacksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:versions="clr-namespace:ErhioLab.Craft.Launcher.Versions"
    Foreground="{DynamicResource TextBrush}"
    Background="{DynamicResource PageSurfaceBrush}"
    IsVisibleChanged="DropTarget_Changed"
    IsHitTestVisibleChanged="DropTarget_Changed"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <UserControl.Resources>
        <Style
            x:Key="ShaderConfigActionStyle"
            TargetType="controls:IconButton"
            BasedOn="{StaticResource VersionListActionButtonStyle}">
            <Setter
                Property="Visibility"
                Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsShaderPack}"
                    Value="True">
                    <Setter
                        Property="Visibility"
                        Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid
        x:Name="ContentRoot"
        Margin="{StaticResource FormPageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <controls:LauncherCard
            x:Name="HeaderCard"
            Margin="0,0,0,14">
            <StackPanel>
                <TextBlock
                    Text="{DynamicResource I18n.localPacks.hint}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,12" />
                <WrapPanel>
                    <Button
                        x:Name="BrowseButton"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Click="Browse_Click"
                        Margin="0,0,8,8" />
                    <Button
                        Content="{DynamicResource I18n.mods.installFromFile}"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Click="Import_Click"
                        Margin="0,0,8,8" />
                    <Button
                        Content="{DynamicResource I18n.localPacks.openFolder}"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Click="Folder_Click"
                        Margin="0,0,8,8" />
                    <Button
                        Content="{DynamicResource I18n.mods.refresh}"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Click="Refresh_Click"
                        Margin="0,0,8,8" />
                    <Button
                        Content="{DynamicResource I18n.mods.selectAll}"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Click="SelectAll_Click"
                        Margin="0,0,0,8" />
                </WrapPanel>
                <TextBox
                    x:Name="SearchBox"
                    Style="{StaticResource FormTextBoxStyle}"
                    ToolTip="{DynamicResource I18n.localPacks.search}"
                    TextChanged="Search_Changed" />
            </StackPanel>
        </controls:LauncherCard>
        <Border
            x:Name="ListCard"
            Grid.Row="1"
            Padding="12">
            <Border.Style>
                <Style
                    TargetType="Border"
                    BasedOn="{StaticResource PanelCardStyle}">
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding IsExpanded, ElementName=DetailsReveal}"
                            Value="True">
                            <Setter
                                Property="Visibility"
                                Value="Hidden" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <ListBox
                    x:Name="PackList"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionMode="Extended"
                    SelectionChanged="Selection_Changed"
                    MouseDoubleClick="Pack_DoubleClick"
                    PreviewKeyDown="Pack_KeyDown"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style
                            TargetType="ListBoxItem"
                            BasedOn="{StaticResource SelectableListRowStyle}">
                            <Setter
                                Property="MinHeight"
                                Value="72" />
                            <Setter
                                Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate
                            DataType="{x:Type versions:LocalMinecraftPackRow}">
                            <Grid
                                Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="54" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Opacity="{Binding IconOpacity}"
                                    Width="38"
                                    Height="38"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <Path
                                        Data="{Binding FallbackIcon}"
                                        Stroke="{DynamicResource TextMutedBrush}"
                                        StrokeThickness="1.5"
                                        Width="24"
                                        Height="24"
                                        Stretch="Uniform">
                                        <Path.Style>
                                            <Style
                                                TargetType="Path">
                                                <Setter
                                                    Property="Visibility"
                                                    Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding Icon}"
                                                        Value="{x:Null}">
                                                        <Setter
                                                            Property="Visibility"
                                                            Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Image
                                        Source="{Binding Icon}"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    ToolTip="{Binding FileName}">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <controls:MinecraftDescriptionTextBlock
                                        Spans="{Binding Description}"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        FontSize="{DynamicResource CaptionFontSize}"
                                        SingleLine="True"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{Binding Summary}"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        FontSize="{DynamicResource SmallFontSize}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource VersionListActionsStyle}">
                                    <controls:IconButton
                                        Style="{StaticResource VersionListActionButtonStyle}"
                                        Icon="{x:Static icons:LauncherIcons.Info}"
                                        ToolTip="{DynamicResource I18n.localPacks.details}"
                                        Tag="{Binding}"
                                        Click="Details_Click" />
                                    <controls:IconButton
                                        Style="{StaticResource VersionListActionButtonStyle}"
                                        Icon="{x:Static icons:LauncherIcons.Folder}"
                                        ToolTip="{DynamicResource I18n.mods.reveal}"
                                        Tag="{Binding}"
                                        Click="Reveal_Click" />
                                    <controls:IconButton
                                        Style="{StaticResource VersionListActionButtonStyle}"
                                        Icon="{Binding ToggleIcon}"
                                        IsEnabled="{Binding CanToggle}"
                                        ToolTip="{Binding ToggleLabel}"
                                        Tag="{Binding}"
                                        Click="Toggle_Click" />
                                    <controls:IconButton
                                        Style="{StaticResource VersionListActionButtonStyle}"
                                        Icon="{x:Static icons:LauncherIcons.Delete}"
                                        ToolTip="{DynamicResource I18n.mods.delete}"
                                        Tag="{Binding}"
                                        Click="Delete_Click" />
                                    <controls:IconButton
                                        Style="{StaticResource ShaderConfigActionStyle}"
                                        Icon="{x:Static icons:LauncherIcons.ArrowDown}"
                                        ToolTip="{DynamicResource I18n.localPacks.importShaderConfig}"
                                        Tag="{Binding}"
                                        Click="ImportShaderConfig_Click" />
                                    <controls:IconButton
                                        Style="{StaticResource ShaderConfigActionStyle}"
                                        Icon="{x:Static icons:LauncherIcons.ArrowUp}"
                                        ToolTip="{DynamicResource I18n.localPacks.exportShaderConfig}"
                                        IsEnabled="{Binding HasShaderConfig}"
                                        Tag="{Binding}"
                                        Click="ExportShaderConfig_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                    x:Name="EmptyText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{DynamicResource TextMutedBrush}"
                    TextWrapping="Wrap"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>
        <controls:LocalItemSelectionBar
            x:Name="SelectionBar"
            Grid.Row="2" />
        <controls:AnimatedReveal
            x:Name="DetailsReveal"
            Grid.Row="1"
            VerticalAlignment="Top">
            <controls:LocalItemInfoCard
                Height="{Binding ActualHeight, ElementName=ListCard}"
                Heading="{Binding Name}"
                CloseRequested="CloseDetails_Click">
                <StackPanel>
                    <controls:MinecraftDescriptionTextBlock
                        Spans="{Binding Description}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding Details}"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding FormatText}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style
                                TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding FormatText}"
                                        Value="">
                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock
                        Text="{Binding Compatibility}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding Error}"
                        Foreground="{DynamicResource DangerTextBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </controls:LocalItemInfoCard>
        </controls:AnimatedReveal>
    </Grid>
</UserControl>
