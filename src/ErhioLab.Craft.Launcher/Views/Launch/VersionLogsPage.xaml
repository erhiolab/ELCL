<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Launch.VersionLogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:local="clr-namespace:ErhioLab.Craft.Launcher.Views.Launch"
    Background="{DynamicResource InkBrush}">
    <Grid
        x:Name="Overview"
        Margin="{StaticResource FormPageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <Border
            Margin="0,0,0,14"
            Padding="20,16"
            Style="{StaticResource PanelCardStyle}">
            <StackPanel>
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextBrush}"
                    Text="{DynamicResource I18n.versionLogs.title}" />
                <TextBlock
                    x:Name="DirectoryText"
                    Margin="0,6,0,12"
                    Foreground="{DynamicResource TextMutedBrush}"
                    TextTrimming="CharacterEllipsis" />
                <WrapPanel>
                    <Button
                        x:Name="RefreshButton"
                        Margin="0,0,8,0"
                        Click="Refresh_Click"
                        Content="{DynamicResource I18n.versionLogs.refresh}"
                        Style="{StaticResource CompactActionButtonStyle}" />
                    <Button
                        Margin="0,0,8,0"
                        Click="OpenFolder_Click"
                        Content="{DynamicResource I18n.versionLogs.openFolder}"
                        Style="{StaticResource CompactActionButtonStyle}" />
                    <Button
                        x:Name="OpenButton"
                        Click="Open_Click"
                        Content="{DynamicResource I18n.versionLogs.open}"
                        IsEnabled="False"
                        Style="{StaticResource CompactActionButtonStyle}" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border
            Grid.Row="1"
            Padding="12"
            Style="{StaticResource PanelCardStyle}">
            <Grid>
                <ListBox
                    x:Name="FilesList"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionMode="Single"
                    SelectionChanged="Files_SelectionChanged"
                    MouseDoubleClick="Files_DoubleClick"
                    PreviewKeyDown="Files_KeyDown"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ItemContainerStyle="{StaticResource SelectableListRowStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate
                            DataType="{x:Type local:VersionLogListItem}">
                            <Grid
                                ToolTip="{Binding Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="Auto" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path
                                    Width="20"
                                    Height="22"
                                    Margin="0,0,14,0"
                                    Data="{x:Static icons:LauncherIcons.Document}"
                                    Stroke="{DynamicResource TextMutedBrush}"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    Stretch="Uniform" />
                                <StackPanel
                                    Grid.Column="1">
                                    <TextBlock
                                        Foreground="{DynamicResource TextBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding Details}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                    x:Name="EmptyText"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource I18n.versionLogs.empty}"
                    TextWrapping="Wrap"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
