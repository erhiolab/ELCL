<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Launch.LaunchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource InkBrush}">
    <Grid
        Margin="{StaticResource FormPageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="18" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    FontFamily="{StaticResource DisplayFont}"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{DynamicResource I18n.launchPage.news}" />
                <TextBlock
                    Margin="0,5,0,0"
                    FontFamily="{StaticResource MonoFont}"
                    FontSize="{DynamicResource SmallFontSize}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource I18n.launchPage.announcementsLabel}" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Bottom"
                FontSize="{DynamicResource CaptionFontSize}"
                Foreground="{DynamicResource TextMutedBrush}"
                Text="{DynamicResource I18n.launchPage.noUpdates}" />
        </Grid>

        <Border
            Grid.Row="2"
            Background="{DynamicResource InkRaisedBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource MonoFont}"
                    FontSize="{DynamicResource CaptionFontSize}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource I18n.launchPage.noAnnouncementsLabel}" />
                <TextBlock
                    Margin="0,9,0,0"
                    HorizontalAlignment="Center"
                    FontSize="{DynamicResource LabelFontSize}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource I18n.launchPage.newsPlaceholder}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
