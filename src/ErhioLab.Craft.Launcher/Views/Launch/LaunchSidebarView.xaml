<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Launch.LaunchSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons">
    <UserControl.Resources>
        <Style
            x:Key="AccountEntryStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource TextBrush}" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                            <Grid>
                                <Border
                                    Background="{DynamicResource PanelHoverBrush}"
                                    CornerRadius="10"
                                    Style="{StaticResource HoverLayerStyle}" />
                                <ContentPresenter
                                    Margin="18,16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid
        Margin="26,24">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Click="AccountManagement_Click"
            Style="{StaticResource AccountEntryStyle}"
            ToolTip="{DynamicResource I18n.launchSidebar.openAccountManager}">
            <StackPanel>
                <Border
                    Width="78"
                    Height="78"
                    HorizontalAlignment="Center"
                    CornerRadius="12"
                    Style="{StaticResource PanelCardStyle}">
                    <Path
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="31"
                        Height="31"
                        Data="{x:Static icons:LauncherIcons.User}"
                        Stroke="{DynamicResource TextMutedBrush}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        Stretch="Uniform" />
                </Border>
                <TextBlock
                    x:Name="AccountNameText"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource DisplayFont}"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextBrush}"
                    Text="{DynamicResource I18n.launchSidebar.notSignedIn}" />
                <TextBlock
                    x:Name="AccountDescriptionText"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource I18n.launchSidebar.manageAccountsHint}" />
            </StackPanel>
        </Button>

        <!-- 当前无可启动版本, 主操作暂以下载入口占位. -->
        <StackPanel
            Grid.Row="1">
            <Button
                Click="DownloadVersion_Click"
                Style="{StaticResource PrimaryActionStyle}">
                <StackPanel>
                    <TextBlock
                        x:Name="MainActionTitle"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Text="{DynamicResource I18n.launchSidebar.downloadGameVersion}" />
                    <TextBlock
                        x:Name="MainActionDescription"
                        Margin="0,3,0,0"
                        HorizontalAlignment="Center"
                        FontSize="9"
                        Opacity="0.65"
                        Text="{DynamicResource I18n.launchSidebar.noLaunchableInstance}" />
                </StackPanel>
            </Button>

            <Grid
                Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="10" />
                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Click="VersionSelection_Click"
                    Content="{DynamicResource I18n.common.selectVersion}"
                    Style="{StaticResource SecondaryActionStyle}" />
                <Button
                    Grid.Column="2"
                    Content="{DynamicResource I18n.launchSidebar.versionSettings}"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryActionStyle}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
