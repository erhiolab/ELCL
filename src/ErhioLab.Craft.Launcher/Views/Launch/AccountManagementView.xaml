<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Launch.AccountManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:local="clr-namespace:ErhioLab.Craft.Launcher.Views.Launch"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <Grid
            Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*"
                    MinWidth="360" />
                <ColumnDefinition
                    Width="18" />
                <ColumnDefinition
                    Width="260" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0">
                <Border
                    Padding="16"
                    Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <Grid
                            Margin="0,0,0,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextBrush}"
                                Text="{DynamicResource I18n.account.accounts}" />
                            <TextBlock
                                x:Name="AccountCountText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                        <TextBlock
                            x:Name="EmptyHint"
                            Padding="12,24"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{DynamicResource I18n.account.noAccounts}" />
                        <ListBox
                            x:Name="AccountsList"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource TextBrush}"
                            ItemContainerStyle="{StaticResource AccountListItemStyle}"
                            SelectionChanged="AccountsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate
                                    DataType="{x:Type local:AccountRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="36" />
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="30"
                                            Height="30"
                                            CornerRadius="7"
                                            Background="{DynamicResource AccentMutedBrush}">
                                            <Path
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="16"
                                                Height="16"
                                                Data="{x:Static icons:LauncherIcons.User}"
                                                Stroke="{DynamicResource AccentTextBrush}"
                                                StrokeThickness="1.5"
                                                StrokeStartLineCap="Round"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                Stretch="Uniform" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextBrush}"
                                                Text="{Binding UserName}" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="10"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding Uuid}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Text="{Binding KindText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,16,0,0"
                    Padding="16"
                    Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextBrush}"
                            Text="{DynamicResource I18n.account.skinsAndCapes}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{DynamicResource I18n.account.skinPreviewPlaceholder}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel
                Grid.Column="2">
                <Border
                    Padding="16"
                    Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextBrush}"
                            Text="{DynamicResource I18n.account.addAccount}" />
                        <Button
                            Margin="0,14,0,0"
                            Content="{DynamicResource I18n.account.addMicrosoftAccount}"
                            Click="StartMicrosoftLogin_Click"
                            Style="{StaticResource AccountPrimaryActionStyle}" />
                        <Button
                            Margin="0,8,0,0"
                            Content="{DynamicResource I18n.account.addOfflineAccount}"
                            Click="ShowAdd_Click"
                            Style="{StaticResource AccountSmallActionStyle}" />
                        <Border
                            x:Name="MicrosoftLoginHost"
                            Height="0"
                            ClipToBounds="True">
                            <StackPanel
                                x:Name="MicrosoftLoginPanel"
                                Margin="0,14,0,0"
                                Opacity="0">
                                <TextBlock
                                    x:Name="MicrosoftStatusText"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{DynamicResource I18n.account.gettingSignInCode}"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    x:Name="MicrosoftCodeText"
                                    Margin="0,8,0,0"
                                    IsReadOnly="True"
                                    HorizontalContentAlignment="Center"
                                    FontFamily="{StaticResource MonoFont}"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource FormTextBoxStyle}" />
                                <Grid
                                    Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="*" />
                                        <ColumnDefinition
                                            Width="8" />
                                        <ColumnDefinition
                                            Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="CopyMicrosoftCodeButton"
                                        Content="{DynamicResource I18n.account.copyCode}"
                                        Click="CopyMicrosoftCode_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource AccountSmallActionStyle}" />
                                    <Button
                                        x:Name="OpenMicrosoftPageButton"
                                        Grid.Column="2"
                                        Content="{DynamicResource I18n.account.openSignInPage}"
                                        Click="OpenMicrosoftPage_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource AccountSmallActionStyle}" />
                                </Grid>
                                <Button
                                    Margin="0,8,0,0"
                                    Content="{DynamicResource I18n.account.cancelSignIn}"
                                    Click="CancelMicrosoftLogin_Click"
                                    Style="{StaticResource AccountSmallActionStyle}" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="AddFormHost"
                            Height="0"
                            ClipToBounds="True">
                            <StackPanel
                                x:Name="AddForm"
                                Margin="0,14,0,0"
                                Opacity="0">
                                <TextBlock
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{DynamicResource I18n.account.minecraftUserName}" />
                                <TextBox
                                    x:Name="UserNameBox"
                                    Margin="0,6,0,0"
                                    MaxLength="16"
                                    Style="{StaticResource FormTextBoxStyle}"
                                    KeyDown="UserNameBox_KeyDown" />
                                <TextBlock
                                    x:Name="ValidationText"
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                                <Grid
                                    Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="*" />
                                        <ColumnDefinition
                                            Width="8" />
                                        <ColumnDefinition
                                            Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Content="{DynamicResource I18n.common.cancel}"
                                        Click="CancelAdd_Click"
                                        Style="{StaticResource AccountSmallActionStyle}" />
                                    <Button
                                        Grid.Column="2"
                                        Content="{DynamicResource I18n.account.create}"
                                        Click="CreateOffline_Click"
                                        Style="{StaticResource AccountSmallActionStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,16,0,0"
                    Padding="16"
                    Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextBrush}"
                            Text="{DynamicResource I18n.account.selectedAccount}" />
                        <Grid
                            Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="SelectedNameText"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextBrush}"
                                Text="{DynamicResource I18n.account.noneSelectedHint}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                x:Name="SelectedInfoIcon"
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Visibility="Collapsed">
                                <Path
                                    Width="13"
                                    Height="13"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{x:Static icons:LauncherIcons.Info}"
                                    Stroke="{DynamicResource AccentTextBrush}"
                                    StrokeThickness="1.3"
                                    Stretch="Uniform" />
                            </Border>
                        </Grid>
                        <Button
                            x:Name="UseButton"
                            Margin="0,16,0,0"
                            Content="{DynamicResource I18n.account.useAccount}"
                            Click="UseSelected_Click"
                            IsEnabled="False"
                            Style="{StaticResource AccountPrimaryActionStyle}" />
                        <Button
                            x:Name="DeleteButton"
                            Margin="0,8,0,0"
                            Content="{DynamicResource I18n.account.deleteAccount}"
                            Click="DeleteSelected_Click"
                            IsEnabled="False"
                            Style="{StaticResource AccountSmallActionStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
