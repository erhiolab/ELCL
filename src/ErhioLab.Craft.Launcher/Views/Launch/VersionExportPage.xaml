<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Launch.VersionExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:versions="clr-namespace:ErhioLab.Craft.Launcher.Versions"
    Background="{DynamicResource InkBrush}">
    <UserControl.Resources>
        <HierarchicalDataTemplate
            DataType="{x:Type versions:ModpackExportNode}"
            ItemsSource="{Binding VisibleChildren}">
            <Grid
                MinHeight="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    VerticalAlignment="Center"
                    Content="{Binding Name}"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    IsEnabled="{Binding CanSelect}"
                    IsThreeState="False"
                    ToolTip="{Binding Path}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource CaptionFontSize}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{Binding Summary}" />
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Margin="{StaticResource FormPageContentMargin}">
                <Border
                    Padding="20"
                    Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Text="{DynamicResource I18n.packExport.name}" />
                        <TextBox
                            x:Name="NameBox"
                            Grid.Column="1"
                            MaxLength="128"
                            TextChanged="Identity_Changed" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="20,0,12,0"
                            VerticalAlignment="Center"
                            Text="{DynamicResource I18n.packExport.version}" />
                        <TextBox
                            x:Name="VersionBox"
                            Grid.Column="3"
                            MaxLength="64"
                            Text="1.0.0"
                            TextChanged="Identity_Changed" />
                    </Grid>
                </Border>
                <controls:LauncherCard
                    Margin="{StaticResource FormSectionSpacing}"
                    Header="{DynamicResource I18n.packExport.contents}">
                    <StackPanel>
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="{DynamicResource I18n.packExport.requiredGame}"
                            IsChecked="True"
                            IsEnabled="False" />
                        <TextBlock
                            x:Name="GameText"
                            Margin="28,2,0,8"
                            Foreground="{DynamicResource TextMutedBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ScanText"
                            Margin="0,8,0,8"
                            Foreground="{DynamicResource TextMutedBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <ItemsControl
                            x:Name="CategoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    DataType="{x:Type versions:ModpackExportNode}">
                                    <Grid
                                        MinHeight="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="{Binding Name}"
                                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                            IsEnabled="{Binding CanSelect}"
                                            IsThreeState="False" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource CaptionFontSize}"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Text="{Binding Summary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox
                            x:Name="IncludeLauncherBox"
                            Margin="0,12,0,0"
                            Content="{DynamicResource I18n.packExport.includeLauncher}" />
                        <TextBlock
                            Margin="28,4,0,0"
                            FontSize="{DynamicResource CaptionFontSize}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{DynamicResource I18n.packExport.launcherHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:LauncherCard>
                <Border
                    Margin="{StaticResource FormSectionSpacing}"
                    Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <ToggleButton
                            x:Name="FilesToggle"
                            Content="{DynamicResource I18n.packExport.precise}"
                            Style="{StaticResource CardExpanderHeaderStyle}" />
                        <controls:AnimatedReveal
                            IsExpanded="{Binding IsChecked, ElementName=FilesToggle}">
                            <StackPanel
                                Margin="20,0,20,20">
                                <TextBlock
                                    Margin="0,0,0,12"
                                    Text="{DynamicResource I18n.packExport.search}" />
                                <TextBox
                                    x:Name="SearchBox"
                                    TextChanged="Search_Changed"
                                    ToolTip="{DynamicResource I18n.packExport.search}" />
                                <TreeView
                                    x:Name="FileTree"
                                    MaxHeight="360"
                                    Margin="0,10,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextBrush}"
                                    controls:ScrollViewerAssist.ChainMouseWheel="True"
                                    ScrollViewer.CanContentScroll="True"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    VirtualizingStackPanel.IsVirtualizing="True"
                                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                                    VirtualizingPanel.ScrollUnit="Pixel"
                                    ItemContainerStyle="{StaticResource FileTreeItemStyle}" />
                            </StackPanel>
                        </controls:AnimatedReveal>
                    </StackPanel>
                </Border>
                <Border
                    Margin="{StaticResource FormSectionSpacing}"
                    Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                        <ToggleButton
                            x:Name="AdvancedToggle"
                            Content="{DynamicResource I18n.packExport.advanced}"
                            Style="{StaticResource CardExpanderHeaderStyle}" />
                        <controls:AnimatedReveal
                            IsExpanded="{Binding IsChecked, ElementName=AdvancedToggle}">
                            <StackPanel
                                Margin="20,0,20,20">
                                <CheckBox
                                    x:Name="BundleBox"
                                    Checked="Bundle_Changed"
                                    Unchecked="Bundle_Changed"
                                    Content="{DynamicResource I18n.packExport.bundle}"
                                    ToolTip="{DynamicResource I18n.packExport.bundleHint}" />
                                <CheckBox
                                    x:Name="OnlyModrinthBox"
                                    Margin="0,12,0,0"
                                    Content="{DynamicResource I18n.packExport.onlyModrinth}"
                                    ToolTip="{DynamicResource I18n.packExport.lookupHint}" />
                                <WrapPanel
                                    Margin="0,16,0,0">
                                    <Button
                                        Click="ReadProfile_Click"
                                        Content="{DynamicResource I18n.packExport.readProfile}"
                                        Style="{StaticResource PageActionButtonStyle}" />
                                    <Button
                                        Click="SaveProfile_Click"
                                        Content="{DynamicResource I18n.packExport.saveProfile}"
                                        Style="{StaticResource PageActionButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </controls:AnimatedReveal>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border
            Grid.Row="1"
            Padding="24,12"
            Background="{DynamicResource InkRaisedBrush}"
            BorderBrush="{DynamicResource LineSoftBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="SelectionText"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextMutedBrush}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="StartButton"
                    Grid.Column="1"
                    MinWidth="140"
                    Height="40"
                    Click="Start_Click"
                    Content="{DynamicResource I18n.packExport.start}"
                    Style="{StaticResource PrimaryActionStyle}"
                    IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
