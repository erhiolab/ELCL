<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.DownloadSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <controls:LauncherCard
                Header="{DynamicResource I18n.downloadSettings.sources}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                Text="{DynamicResource I18n.downloadSettings.versionListSource}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{DynamicResource I18n.downloadSettings.fallbackDescription}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="VersionListSourceBox"
                            Grid.Column="1"
                            Style="{StaticResource FormComboBoxStyle}"
                            SelectionChanged="VersionListSourceBox_SelectionChanged">
                            <ComboBoxItem
                                Content="{DynamicResource I18n.downloadSettings.preferOfficial}" />
                            <ComboBoxItem
                                Content="{DynamicResource I18n.downloadSettings.preferMirror}" />
                        </ComboBox>
                    </Grid>
                    <Grid
                        Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                Text="{DynamicResource I18n.downloadSettings.fileDownloadSource}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{DynamicResource I18n.downloadSettings.fallbackDescription}" />
                        </StackPanel>
                        <ComboBox
                            x:Name="FileDownloadSourceBox"
                            Grid.Column="1"
                            Style="{StaticResource FormComboBoxStyle}"
                            SelectionChanged="FileDownloadSourceBox_SelectionChanged">
                            <ComboBoxItem
                                Content="{DynamicResource I18n.downloadSettings.preferOfficial}" />
                            <ComboBoxItem
                                Content="{DynamicResource I18n.downloadSettings.preferMirror}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                Margin="0,14,0,0"
                Header="{DynamicResource I18n.downloadSettings.multithreadedDownload}">
                <StackPanel>
                    <Grid
                        Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                Text="{DynamicResource I18n.downloadSettings.maxConnections}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{DynamicResource I18n.downloadSettings.connectionRangeHint}" />
                        </StackPanel>
                        <Grid
                            Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="52" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="ThreadCountSlider"
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Minimum="1"
                                Maximum="256"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="ThreadCountSlider_ValueChanged"
                                PreviewMouseLeftButtonUp="ThreadCountSlider_Commit"
                                LostMouseCapture="ThreadCountSlider_Commit"
                                KeyUp="ThreadCountSlider_KeyUp" />
                            <TextBlock
                                x:Name="ThreadCountText"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="8" />
                        </Grid>
                    </Grid>
                    <Border
                        Height="1"
                        Margin="0,10"
                        Background="{DynamicResource LineSoftBrush}" />
                    <Grid
                        Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                Text="{DynamicResource I18n.downloadSettings.speedLimit}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{DynamicResource I18n.downloadSettings.speedLimitHint}" />
                        </StackPanel>
                        <TextBox
                            x:Name="SpeedLimitBox"
                            Grid.Column="1"
                            Height="34"
                            Style="{StaticResource FormTextBoxStyle}"
                            LostFocus="DownloadValueBox_LostFocus"
                            KeyDown="DownloadValueBox_KeyDown" />
                    </Grid>
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
