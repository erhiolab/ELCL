<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.LauncherBackgroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:local="clr-namespace:ErhioLab.Craft.Launcher.Views.Settings"
    Background="{DynamicResource PageSurfaceBrush}"
    Loaded="Card_Loaded"
    Unloaded="Card_Unloaded">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <Border
                Padding="14"
                Style="{StaticResource PanelCardStyle}">
                <DockPanel
                    LastChildFill="True">
                    <controls:IconButton
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        Click="Back_Click"
                        Icon="{x:Static icons:LauncherIcons.Back}"
                        ToolTip="{DynamicResource I18n.common.back}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{DynamicResource I18n.background.manage}" />
                </DockPanel>
            </Border>
            <controls:LauncherCard
                Margin="{StaticResource FormSectionSpacing}"
                Header="{DynamicResource I18n.background.settings}">
                <StackPanel>
                    <CheckBox
                        x:Name="EnabledBox"
                        Checked="PlaybackOption_Changed"
                        Content="{DynamicResource I18n.background.enabled}"
                        Style="{StaticResource FormCheckBoxStyle}"
                        Unchecked="PlaybackOption_Changed" />
                    <CheckBox
                        x:Name="PlayInBackgroundBox"
                        Checked="PlaybackOption_Changed"
                        Content="{DynamicResource I18n.background.playInBackground}"
                        Style="{StaticResource FormCheckBoxStyle}"
                        ToolTip="{DynamicResource I18n.background.playInBackgroundTip}"
                        Unchecked="PlaybackOption_Changed" />
                    <Grid
                        Style="{StaticResource FormFollowingSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource I18n.background.playbackMode}" />
                        <ComboBox
                            x:Name="ModeBox"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            MinWidth="180"
                            SelectionChanged="Mode_Changed"
                            Style="{StaticResource FormComboBoxStyle}">
                            <ComboBoxItem
                                Content="{DynamicResource I18n.background.randomOnStartup}" />
                            <ComboBoxItem
                                Content="{DynamicResource I18n.background.fixed}" />
                            <ComboBoxItem
                                Content="{DynamicResource I18n.background.slideshow}" />
                        </ComboBox>
                    </Grid>
                    <controls:AnimatedReveal
                        x:Name="IntervalReveal">
                        <Grid
                            Style="{StaticResource FormFollowingSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="155" />
                                <ColumnDefinition
                                    Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{DynamicResource I18n.background.interval}" />
                            <ComboBox
                                x:Name="IntervalBox"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                MinWidth="180"
                                DisplayMemberPath="Value"
                                SelectedValuePath="Key"
                                SelectionChanged="Interval_Changed"
                                Style="{StaticResource FormComboBoxStyle}" />
                        </Grid>
                    </controls:AnimatedReveal>
                    <TextBlock
                        x:Name="NowShowing"
                        Margin="0,14,0,0"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <controls:AnimatedReveal
                        x:Name="OptionsReveal">
                        <StackPanel>
                            <Grid
                                Style="{StaticResource FormFollowingSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.background.fit}" />
                                <ComboBox
                                    x:Name="FitBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    MinWidth="180"
                                    SelectionChanged="Fit_Changed"
                                    Style="{StaticResource FormComboBoxStyle}">
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.cover}" />
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.contain}" />
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.stretch}" />
                                </ComboBox>
                            </Grid>
                            <Grid
                                Style="{StaticResource FormFollowingSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.background.opacity}" />
                                <Slider
                                    x:Name="BackgroundOpacitySlider"
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="100"
                                    TickFrequency="1"
                                    ValueChanged="Options_ValueChanged" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFont}"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    Text="{Binding Value, ElementName=BackgroundOpacitySlider, StringFormat={}{0:0}%}"
                                    TextAlignment="Right" />
                            </Grid>
                            <Grid
                                Style="{StaticResource FormFollowingSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.background.cardOpacity}" />
                                <Slider
                                    x:Name="CardOpacitySlider"
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="100"
                                    TickFrequency="1"
                                    ValueChanged="Options_ValueChanged" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFont}"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    Text="{Binding Value, ElementName=CardOpacitySlider, StringFormat={}{0:0}%}"
                                    TextAlignment="Right" />
                            </Grid>
                            <Grid
                                Style="{StaticResource FormFollowingSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.background.blur}" />
                                <Slider
                                    x:Name="BlurSlider"
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="32"
                                    TickFrequency="1"
                                    ValueChanged="Options_ValueChanged" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFont}"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    Text="{Binding Value, ElementName=BlurSlider, StringFormat={}{0:0}}"
                                    TextAlignment="Right" />
                            </Grid>
                            <Grid
                                Style="{StaticResource FormFollowingSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.background.volume}" />
                                <Slider
                                    x:Name="VolumeSlider"
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="100"
                                    TickFrequency="1"
                                    ValueChanged="Options_ValueChanged" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFont}"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:0}%}"
                                    TextAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </controls:AnimatedReveal>
                    <Button
                        x:Name="NextButton"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Left"
                        Click="Next_Click"
                        Content="{DynamicResource I18n.background.next}"
                        Style="{StaticResource PageActionButtonStyle}" />
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                x:Name="GalleryCard"
                Margin="{StaticResource FormSectionSpacing}"
                Header="{DynamicResource I18n.background.gallery}">
                <StackPanel>
                    <StackPanel
                        Orientation="Horizontal">
                        <RadioButton
                            x:Name="LocalSource"
                            GroupName="BackgroundGallerySource"
                            IsChecked="True"
                            Checked="Source_Checked"
                            Content="{DynamicResource I18n.background.localSource}"
                            Style="{StaticResource GalleryTabStyle}" />
                        <RadioButton
                            x:Name="WallpaperSource"
                            GroupName="BackgroundGallerySource"
                            Checked="Source_Checked"
                            Content="{DynamicResource I18n.background.wallpaperSource}"
                            Style="{StaticResource GalleryTabStyle}" />
                    </StackPanel>
                    <WrapPanel
                        x:Name="Actions"
                        Margin="0,14,0,0">
                        <Button
                            x:Name="OpenFolderButton"
                            Click="OpenFolder_Click"
                            Content="{DynamicResource I18n.toolbox.openFolder}"
                            Style="{StaticResource PageActionButtonStyle}" />
                        <Button
                            Click="Refresh_Click"
                            Content="{DynamicResource I18n.background.refresh}"
                            Style="{StaticResource PageActionButtonStyle}" />
                        <Button
                            x:Name="ClearButton"
                            Click="Clear_Click"
                            Content="{DynamicResource I18n.background.clear}"
                            Style="{StaticResource PageActionButtonStyle}"
                            Visibility="Collapsed" />
                    </WrapPanel>
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="0,10,0,0"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                    <ItemsControl
                        x:Name="Gallery"
                        Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate
                                DataType="{x:Type local:LauncherBackgroundTile}">
                                <Button
                                    Width="172"
                                    Height="131"
                                    Margin="0,4,8,4"
                                    Padding="5"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Click="SelectTile_Click"
                                    ToolTip="{Binding ToolTip}">
                                    <Button.Style>
                                        <Style
                                            TargetType="Button"
                                            BasedOn="{StaticResource SecondaryActionStyle}">
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsCurrent}"
                                                    Value="True">
                                                    <Setter
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}" />
                                                    <Setter
                                                        Property="Background"
                                                        Value="{DynamicResource AccentMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel
                                        Width="160">
                                        <Border
                                            Height="79"
                                            Background="{DynamicResource InkBrush}"
                                            ClipToBounds="True"
                                            CornerRadius="5">
                                            <Grid
                                                ClipToBounds="True">
                                                <Path
                                                    Width="24"
                                                    Height="24"
                                                    Data="{Binding Icon}"
                                                    Stretch="Uniform"
                                                    Stroke="{DynamicResource TextMutedBrush}"
                                                    StrokeThickness="1.4"
                                                    StrokeLineJoin="Round" />
                                                <Image
                                                    Source="{Binding Thumbnail}"
                                                    Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            Margin="1,5,1,0"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="1,1,1,0"
                                            FontSize="{DynamicResource CaptionFontSize}"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Text="{Binding StatusLabel}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
