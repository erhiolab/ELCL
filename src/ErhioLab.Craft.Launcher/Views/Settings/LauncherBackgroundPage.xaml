<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.LauncherBackgroundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:local="clr-namespace:ErhioLab.Craft.Launcher.Views.Settings"
    Background="{DynamicResource PageSurfaceBrush}"
    Loaded="Card_Loaded"
    Unloaded="Card_Unloaded">
    <UserControl.Resources>
        <Style
            x:Key="BackgroundPickerRowStyle"
            TargetType="Grid"
            BasedOn="{StaticResource FormFollowingSettingRowStyle}">
            <Setter
                Property="Margin"
                Value="0,14,24,0" />
        </Style>
        <Style
            x:Key="BackgroundSliderStyle"
            TargetType="Slider"
            BasedOn="{StaticResource {x:Type Slider}}">
            <Setter
                Property="IsSnapToTickEnabled"
                Value="True" />
            <Setter
                Property="Maximum"
                Value="100" />
            <Setter
                Property="TickFrequency"
                Value="1" />
        </Style>
        <Style
            x:Key="BackgroundSliderFieldStyle"
            TargetType="HeaderedContentControl">
            <Setter
                Property="Margin"
                Value="12,14,12,0" />
            <Setter
                Property="Tag"
                Value="%" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="HeaderedContentControl">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    FontFamily="{StaticResource MonoFont}"
                                    Foreground="{DynamicResource AccentTextBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding
                                            StringFormat="{}{0:0}{1}">
                                            <Binding
                                                Path="Content.(primitives:RangeBase.Value)"
                                                RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding
                                                Path="Tag"
                                                RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ContentPresenter
                                    ContentSource="Header" />
                            </DockPanel>
                            <ContentPresenter
                                Margin="0,4,0,0" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <Border
                Padding="14"
                Style="{StaticResource PanelCardStyle}">
                <DockPanel
                    LastChildFill="True">
                    <controls:IconButton
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        Click="Back_Click"
                        Icon="{x:Static icons:LauncherIcons.Back}"
                        ToolTip="{DynamicResource I18n.common.back}" />
                    <StackPanel
                        x:Name="PlaybackNavigation"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <controls:IconButton
                            Width="32"
                            Height="32"
                            AutomationProperties.Name="{DynamicResource I18n.background.previous}"
                            Click="Previous_Click"
                            Icon="{x:Static icons:LauncherIcons.SkipBackward}"
                            ToolTip="{DynamicResource I18n.background.previous}" />
                        <controls:IconButton
                            Width="32"
                            Height="32"
                            Margin="4,0,0,0"
                            AutomationProperties.Name="{DynamicResource I18n.background.next}"
                            Click="Next_Click"
                            Icon="{x:Static icons:LauncherIcons.SkipForward}"
                            ToolTip="{DynamicResource I18n.background.next}" />
                    </StackPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{DynamicResource I18n.background.manage}" />
                    <Border
                        x:Name="CurrentBackgroundDetail"
                        Margin="14,0,0,0"
                        Padding="14,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="CurrentBackgroundLabel"
                            FontSize="{DynamicResource LabelFontSize}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </Border>
                </DockPanel>
            </Border>
            <controls:LauncherCard
                Margin="{StaticResource FormSectionSpacing}"
                Header="{DynamicResource I18n.background.settings}">
                <StackPanel>
                    <WrapPanel>
                        <CheckBox
                            x:Name="EnabledBox"
                            Margin="0,0,24,0"
                            VerticalAlignment="Center"
                            Checked="PlaybackOption_Changed"
                            Content="{DynamicResource I18n.background.enabled}"
                            Style="{StaticResource FormCheckBoxStyle}"
                            Unchecked="PlaybackOption_Changed" />
                        <CheckBox
                            x:Name="PlayInBackgroundBox"
                            Margin="0,0,24,0"
                            VerticalAlignment="Center"
                            Checked="PlaybackOption_Changed"
                            Content="{DynamicResource I18n.background.playInBackground}"
                            Style="{StaticResource FormCheckBoxStyle}"
                            ToolTip="{DynamicResource I18n.background.playInBackgroundTip}"
                            Unchecked="PlaybackOption_Changed" />
                    </WrapPanel>
                    <WrapPanel>
                        <Grid
                            Style="{StaticResource BackgroundPickerRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="155" />
                                <ColumnDefinition
                                    Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{DynamicResource I18n.background.playbackMode}" />
                            <ComboBox
                                x:Name="ModeBox"
                                Grid.Column="1"
                                MinWidth="180"
                                SelectionChanged="Mode_Changed"
                                Style="{StaticResource FormComboBoxStyle}">
                                <ComboBoxItem
                                    x:Name="RandomModeItem"
                                    Content="{DynamicResource I18n.background.randomOnStartup}" />
                                <ComboBoxItem
                                    Content="{DynamicResource I18n.background.fixed}" />
                                <ComboBoxItem
                                    x:Name="SlideModeItem"
                                    Content="{DynamicResource I18n.background.slideshow}" />
                            </ComboBox>
                        </Grid>
                        <controls:AnimatedReveal
                            x:Name="FitReveal"
                            IsExpanded="{Binding IsExpanded, ElementName=OptionsReveal, Mode=OneWay}">
                            <Grid
                                Style="{StaticResource BackgroundPickerRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.background.fit}" />
                                <ComboBox
                                    x:Name="FitBox"
                                    Grid.Column="1"
                                    MinWidth="180"
                                    SelectionChanged="Fit_Changed"
                                    Style="{StaticResource FormComboBoxStyle}">
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.cover}" />
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.contain}" />
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.stretch}" />
                                </ComboBox>
                            </Grid>
                        </controls:AnimatedReveal>
                        <controls:AnimatedReveal
                            x:Name="IntervalReveal">
                            <Grid
                                Style="{StaticResource BackgroundPickerRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.background.interval}" />
                                <TextBox
                                    x:Name="IntervalBox"
                                    Grid.Column="1"
                                    Width="116"
                                    MaxLength="12"
                                    AutomationProperties.Name="{DynamicResource I18n.background.interval}"
                                    PreviewKeyDown="Interval_KeyDown"
                                    LostKeyboardFocus="Interval_LostKeyboardFocus"
                                    Style="{StaticResource FormTextBoxStyle}"
                                    ToolTip="{DynamicResource I18n.background.intervalTip}" />
                            </Grid>
                        </controls:AnimatedReveal>
                    </WrapPanel>
                    <controls:AnimatedReveal
                        x:Name="MissingBackgroundReveal">
                        <TextBlock
                            x:Name="MissingBackgroundLabel"
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource WarningTextBrush}"
                            TextWrapping="Wrap" />
                    </controls:AnimatedReveal>
                    <controls:AnimatedReveal
                        x:Name="OptionsReveal">
                        <UniformGrid
                            Columns="1"
                            Margin="-12,0,-12,0"
                            SizeChanged="AppearanceFields_SizeChanged">
                            <HeaderedContentControl
                                Header="{DynamicResource I18n.background.opacity}"
                                Style="{StaticResource BackgroundSliderFieldStyle}">
                                <Slider
                                    x:Name="BackgroundOpacitySlider"
                                    AutomationProperties.Name="{DynamicResource I18n.background.opacity}"
                                    Style="{StaticResource BackgroundSliderStyle}"
                                    ValueChanged="Options_ValueChanged" />
                            </HeaderedContentControl>
                            <HeaderedContentControl
                                Header="{DynamicResource I18n.background.cardOpacity}"
                                Style="{StaticResource BackgroundSliderFieldStyle}">
                                <Slider
                                    x:Name="CardOpacitySlider"
                                    AutomationProperties.Name="{DynamicResource I18n.background.cardOpacity}"
                                    Style="{StaticResource BackgroundSliderStyle}"
                                    ValueChanged="Options_ValueChanged" />
                            </HeaderedContentControl>
                            <HeaderedContentControl
                                Header="{DynamicResource I18n.background.navigationOpacity}"
                                Style="{StaticResource BackgroundSliderFieldStyle}">
                                <Slider
                                    x:Name="NavigationOpacitySlider"
                                    AutomationProperties.Name="{DynamicResource I18n.background.navigationOpacity}"
                                    Style="{StaticResource BackgroundSliderStyle}"
                                    ValueChanged="Options_ValueChanged" />
                            </HeaderedContentControl>
                            <HeaderedContentControl
                                Header="{DynamicResource I18n.background.blur}"
                                Style="{StaticResource BackgroundSliderFieldStyle}"
                                Tag="">
                                <Slider
                                    x:Name="BlurSlider"
                                    AutomationProperties.Name="{DynamicResource I18n.background.blur}"
                                    Maximum="32"
                                    Style="{StaticResource BackgroundSliderStyle}"
                                    ValueChanged="Options_ValueChanged" />
                            </HeaderedContentControl>
                            <HeaderedContentControl
                                Header="{DynamicResource I18n.background.volume}"
                                Style="{StaticResource BackgroundSliderFieldStyle}">
                                <Slider
                                    x:Name="VolumeSlider"
                                    AutomationProperties.Name="{DynamicResource I18n.background.volume}"
                                    Style="{StaticResource BackgroundSliderStyle}"
                                    ValueChanged="Options_ValueChanged" />
                            </HeaderedContentControl>
                        </UniformGrid>
                    </controls:AnimatedReveal>
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                x:Name="GalleryCard"
                Margin="{StaticResource FormSectionSpacing}"
                Header="{DynamicResource I18n.background.gallery}">
                <StackPanel>
                    <StackPanel
                        Orientation="Horizontal">
                        <RadioButton
                            x:Name="FavoriteSource"
                            GroupName="BackgroundGallerySource"
                            Checked="Source_Checked"
                            Content="{DynamicResource I18n.background.favoriteSource}"
                            Style="{StaticResource GalleryTabStyle}" />
                        <RadioButton
                            x:Name="LocalSource"
                            GroupName="BackgroundGallerySource"
                            IsChecked="True"
                            Checked="Source_Checked"
                            Content="{DynamicResource I18n.background.localSource}"
                            Style="{StaticResource GalleryTabStyle}" />
                        <RadioButton
                            x:Name="WallpaperSource"
                            GroupName="BackgroundGallerySource"
                            Checked="Source_Checked"
                            Content="{DynamicResource I18n.background.wallpaperSource}"
                            Style="{StaticResource GalleryTabStyle}" />
                    </StackPanel>
                    <WrapPanel
                        x:Name="Actions"
                        Margin="0,14,0,0">
                        <Button
                            x:Name="OpenFolderButton"
                            Click="OpenFolder_Click"
                            Content="{DynamicResource I18n.background.openLocalFolder}"
                            Style="{StaticResource PageActionButtonStyle}" />
                        <Button
                            Click="Refresh_Click"
                            Content="{DynamicResource I18n.background.refresh}"
                            Style="{StaticResource PageActionButtonStyle}" />
                        <Button
                            x:Name="ClearButton"
                            Click="Clear_Click"
                            Content="{DynamicResource I18n.background.clear}"
                            Style="{StaticResource PageActionButtonStyle}"
                            Visibility="Collapsed" />
                    </WrapPanel>
                    <WrapPanel
                        Margin="{StaticResource FormSectionSpacing}"
                        IsEnabled="{Binding IsEnabled, ElementName=Actions}">
                        <StackPanel
                            Margin="0,0,16,8"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource I18n.background.filterSearch}" />
                            <TextBox
                                x:Name="GallerySearchBox"
                                Width="176"
                                AutomationProperties.Name="{DynamicResource I18n.background.filterSearch}"
                                Style="{StaticResource FormTextBoxStyle}"
                                TextChanged="GallerySearch_Changed"
                                ToolTip="{DynamicResource I18n.background.filterSearchTip}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,0,16,8"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Text="{DynamicResource I18n.background.filterMedia}" />
                            <ComboBox
                                x:Name="MediaFilterBox"
                                MinWidth="124"
                                AutomationProperties.Name="{DynamicResource I18n.background.filterMedia}"
                                SelectedIndex="0"
                                SelectionChanged="GalleryFilter_Changed"
                                Style="{StaticResource FormComboBoxStyle}">
                                <ComboBoxItem
                                    Content="{DynamicResource I18n.background.filterAllMedia}" />
                                <ComboBoxItem
                                    Content="{DynamicResource I18n.background.imageTile}" />
                                <ComboBoxItem
                                    Content="{DynamicResource I18n.background.videoTile}" />
                            </ComboBox>
                        </StackPanel>
                        <controls:AnimatedReveal
                            x:Name="AgeFilterReveal">
                            <StackPanel
                                Margin="0,0,0,8"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.background.filterAge}" />
                                <ComboBox
                                    x:Name="AgeFilterBox"
                                    MinWidth="148"
                                    AutomationProperties.Name="{DynamicResource I18n.background.filterAge}"
                                    SelectedIndex="0"
                                    SelectionChanged="GalleryFilter_Changed"
                                    Style="{StaticResource FormComboBoxStyle}">
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.filterAllAges}" />
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.ratingEveryone}" />
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.ratingGuidance}" />
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.ratingAdultsOnly}" />
                                    <ComboBoxItem
                                        Content="{DynamicResource I18n.background.ratingUnrated}" />
                                </ComboBox>
                            </StackPanel>
                        </controls:AnimatedReveal>
                    </WrapPanel>
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="0,10,0,0"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                    <ItemsControl
                        x:Name="Gallery"
                        Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate
                                DataType="{x:Type local:LauncherBackgroundTile}">
                                <Grid
                                    Margin="0,4,8,4">
                                    <Button
                                        Width="172"
                                        Height="131"
                                        Padding="5"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Click="SelectTile_Click"
                                        ToolTip="{Binding ToolTip}">
                                        <Button.Style>
                                            <Style
                                                TargetType="Button"
                                                BasedOn="{StaticResource SecondaryActionStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsCurrent}"
                                                        Value="True">
                                                        <Setter
                                                            Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}" />
                                                        <Setter
                                                            Property="Background"
                                                            Value="{DynamicResource AccentMutedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel
                                            Width="160">
                                            <Border
                                                Height="79"
                                                Background="{DynamicResource InkBrush}"
                                                ClipToBounds="True"
                                                CornerRadius="5">
                                                <Grid
                                                    ClipToBounds="True">
                                                    <Path
                                                        Width="24"
                                                        Height="24"
                                                        Data="{Binding Icon}"
                                                        Stretch="Uniform"
                                                        Stroke="{DynamicResource TextMutedBrush}"
                                                        StrokeThickness="1.4"
                                                        StrokeLineJoin="Round" />
                                                    <Image
                                                        Source="{Binding Thumbnail}"
                                                        Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <TextBlock
                                                Margin="1,5,1,0"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="1,1,1,0"
                                                FontSize="{DynamicResource CaptionFontSize}"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding StatusLabel}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <CheckBox
                                        Width="26"
                                        Height="26"
                                        Margin="0,10,10,0"
                                        Padding="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="{DynamicResource I18n.background.favoriteToggle}"
                                        Background="{x:Static Brushes.Transparent}"
                                        Click="Favorite_Click"
                                        IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                        Style="{StaticResource FormCheckBoxStyle}"
                                        ToolTip="{DynamicResource I18n.background.favoriteToggle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
