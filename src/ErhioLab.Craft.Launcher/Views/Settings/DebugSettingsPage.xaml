<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.DebugSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    Background="{DynamicResource PageSurfaceBrush}">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <controls:LauncherCard
                Header="{DynamicResource I18n.debug.launcherLogs}">
                <StackPanel>
                    <TextBlock
                        FontSize="{DynamicResource LabelFontSize}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource I18n.debug.launcherLogsDescription}"
                        TextWrapping="Wrap" />
                    <ItemsControl
                        x:Name="LauncherLogs"
                        Margin="{StaticResource FormSectionSpacing}"
                        Loaded="LauncherLogs_Loaded">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,0,8,8"
                                    Click="LauncherLog_Click"
                                    Content="{Binding Name}"
                                    IsEnabled="{Binding Exists}"
                                    Style="{StaticResource PageActionButtonStyle}"
                                    ToolTip="{Binding Path}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                Margin="{StaticResource FormSectionSpacing}"
                Header="{DynamicResource I18n.debug.dialogs}">
                <StackPanel>
                    <TextBlock
                        FontSize="{DynamicResource LabelFontSize}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource I18n.debug.dialogPreviewDescription}" />
                    <WrapPanel
                        Margin="0,16,0,0">
                        <Button
                            Width="116"
                            Margin="0,0,10,10"
                            Click="InformationButton_Click"
                            Content="{DynamicResource I18n.debug.information}"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            Width="116"
                            Margin="0,0,10,10"
                            Click="WarningButton_Click"
                            Content="{DynamicResource I18n.debug.warning}"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            Width="116"
                            Margin="0,0,10,10"
                            Click="ErrorButton_Click"
                            Content="{DynamicResource I18n.debug.error}"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            Width="116"
                            Margin="0,0,10,10"
                            Click="Second_Confirmation_Button_Click"
                            Content="{DynamicResource I18n.debug.confirmation}"
                            Style="{StaticResource SecondaryActionStyle}" />
                    </WrapPanel>
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                Margin="{StaticResource FormSectionSpacing}"
                Header="{DynamicResource I18n.debug.notifications}">
                <StackPanel>
                    <TextBlock
                        FontSize="{DynamicResource LabelFontSize}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource I18n.debug.notificationDescription}" />
                    <WrapPanel
                        Margin="0,16,0,0">
                        <Button
                            Width="116"
                            Margin="0,0,10,10"
                            Click="ToastInformationButton_Click"
                            Content="{DynamicResource I18n.debug.informationNotification}"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            Width="116"
                            Margin="0,0,10,10"
                            Click="ToastSuccessButton_Click"
                            Content="{DynamicResource I18n.debug.successNotification}"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            Width="116"
                            Margin="0,0,10,10"
                            Click="ToastErrorButton_Click"
                            Content="{DynamicResource I18n.debug.errorNotification}"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            x:Name="ToastStressButton"
                            Width="164"
                            Margin="0,0,10,10"
                            Click="ToastStressButton_Click"
                            Content="{DynamicResource I18n.debug.performanceTest}"
                            Style="{StaticResource SecondaryActionStyle}" />
                    </WrapPanel>
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
