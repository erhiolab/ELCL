<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.PersonalizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    Background="{DynamicResource InkBrush}"
    Unloaded="PersonalizationPage_Unloaded">
    <UserControl.Resources>
        <!-- 选项卡的悬停层覆盖整个卡片, 不挤占内容空间. -->
        <Style
            x:Key="ThemeChoiceStyle"
            TargetType="RadioButton">
            <Setter
                Property="Width"
                Value="145" />
            <Setter
                Property="Height"
                Value="54" />
            <Setter
                Property="Margin"
                Value="0,0,10,0" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource TextBrush}" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="RadioButton">
                        <Border
                            x:Name="Root"
                            Background="{DynamicResource InkRaisedBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                            <Grid>
                                <Border
                                    Background="{DynamicResource AccentHoverBrush}"
                                    CornerRadius="6"
                                    Style="{StaticResource HoverLayerStyle}" />
                                <ContentPresenter
                                    Margin="14,0"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsChecked"
                                Value="True">
                                <Setter
                                    TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                                <Setter
                                    TargetName="Root"
                                    Property="Background"
                                    Value="{DynamicResource AccentMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="32,28,32,36">
            <controls:LauncherCard
                Header="{DynamicResource I18n.personalization.general}">
                <StackPanel>

                    <Grid
                        Height="42">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="48" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                Text="{DynamicResource I18n.personalization.windowOpacity}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="10"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="40% - 100%" />
                        </StackPanel>
                        <Slider
                            x:Name="OpacitySlider"
                            Grid.Column="1"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="100"
                            Minimum="40"
                            TickFrequency="5"
                            ValueChanged="OpacitySlider_ValueChanged" />
                        <TextBlock
                            x:Name="OpacityValueText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="12"
                            Foreground="{DynamicResource AccentTextBrush}"
                            TextAlignment="Right" />
                    </Grid>

                    <Border
                        Height="1"
                        Margin="0,10"
                        Background="{DynamicResource LineSoftBrush}" />
                    <Grid
                        Height="54">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{DynamicResource I18n.personalization.theme}" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal">
                            <RadioButton
                                x:Name="DayThemeButton"
                                Checked="ThemeButton_Checked"
                                GroupName="LauncherTheme"
                                Style="{StaticResource ThemeChoiceStyle}">
                                <StackPanel
                                    Orientation="Horizontal">
                                    <Path
                                        Width="28"
                                        VerticalAlignment="Center"
                                        Height="19"
                                        Data="{x:Static icons:LauncherIcons.DayTheme}"
                                        Stroke="{DynamicResource AccentTextBrush}"
                                        StrokeThickness="1.5"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{DynamicResource I18n.personalization.lightMode}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="NightThemeButton"
                                Checked="ThemeButton_Checked"
                                GroupName="LauncherTheme"
                                Style="{StaticResource ThemeChoiceStyle}">
                                <StackPanel
                                    Orientation="Horizontal">
                                    <Path
                                        Width="28"
                                        VerticalAlignment="Center"
                                        Height="19"
                                        Data="{x:Static icons:LauncherIcons.NightTheme}"
                                        Stroke="{DynamicResource AccentTextBrush}"
                                        StrokeThickness="1.5"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{DynamicResource I18n.personalization.darkMode}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <Border
                        Height="1"
                        Margin="0,10"
                        Background="{DynamicResource LineSoftBrush}" />
                    <Grid
                        Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{DynamicResource I18n.personalization.accentColor}" />
                        <controls:AccentColorPicker
                            x:Name="AccentPicker"
                            Grid.Column="1"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                Margin="0,14,0,0"
                Header="{DynamicResource I18n.personalization.language}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="155" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{DynamicResource I18n.personalization.interfaceLanguage}" />
                    <ComboBox
                        x:Name="LanguageComboBox"
                        Grid.Column="1"
                        Width="220"
                        Height="34"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Value"
                        SelectedValuePath="Key"
                        SelectionChanged="LanguageComboBox_SelectionChanged" />
                </Grid>
            </controls:LauncherCard>
            <controls:LauncherCard
                Margin="0,14,0,0"
                Header="{DynamicResource I18n.personalization.titleBar}">
                <StackPanel>
                    <Grid
                        Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="NoTitleButton"
                            VerticalAlignment="Center"
                            Checked="TitleBarModeButton_Checked"
                            Content="{DynamicResource I18n.common.none}"
                            GroupName="TitleBarMode" />
                        <RadioButton
                            x:Name="DefaultTitleButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Checked="TitleBarModeButton_Checked"
                            Content="{DynamicResource I18n.personalization.defaultTitle}"
                            GroupName="TitleBarMode" />
                        <RadioButton
                            x:Name="CustomTitleButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Checked="TitleBarModeButton_Checked"
                            Content="{DynamicResource I18n.personalization.textTitle}"
                            GroupName="TitleBarMode" />
                    </Grid>
                    <Grid
                        x:Name="TitleTextRow"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="96" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{DynamicResource I18n.personalization.titleBarText}" />
                        <TextBox
                            x:Name="TitleTextBox"
                            Grid.Column="1"
                            Height="34"
                            Style="{StaticResource FormTextBoxStyle}"
                            MaxLength="40"
                            TextChanged="TitleTextBox_TextChanged" />
                    </Grid>
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
