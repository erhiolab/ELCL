<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.OtherSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,36">
            <Border
                Padding="20"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="其他" />
                    <Border Height="1" Margin="0,13,0,12" Background="{DynamicResource LineSoftBrush}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="这里将提供其他设置." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
