<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.OtherSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <controls:LauncherCard
                Header="{DynamicResource I18n.settings.configuration}">
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource I18n.settings.configurationDescription}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,16,0,0"
                        Orientation="Horizontal">
                        <Button
                            Width="112"
                            Height="36"
                            Click="ExportSettings_Click"
                            Content="{DynamicResource I18n.settings.export}"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            Width="112"
                            Height="36"
                            Margin="10,0,0,0"
                            Click="ImportSettings_Click"
                            Content="{DynamicResource I18n.settings.import}"
                            Style="{StaticResource SecondaryActionStyle}" />
                    </StackPanel>
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
