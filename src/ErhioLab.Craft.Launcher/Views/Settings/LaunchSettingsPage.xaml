<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.LaunchSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:java="clr-namespace:ErhioLab.Craft.Launcher.Core.Java;assembly=ErhioLab.Craft.Launcher.Core"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="32,28,32,36">
            <controls:LauncherCard>
                <controls:LauncherCard.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Java" />
                            <TextBlock
                                x:Name="JavaCountText"
                                Margin="8,3,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="1"
                            Width="96"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="RefreshButton_Click"
                            Content="{DynamicResource I18n.launchSettings.searchAgain}"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            x:Name="AddButton"
                            Grid.Column="2"
                            Width="96"
                            Height="34"
                            Click="AddButton_Click"
                            Content="{DynamicResource I18n.launchSettings.addManually}"
                            Style="{StaticResource SecondaryActionStyle}" />
                    </Grid>
                </controls:LauncherCard.Header>
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap"
                        Text="{DynamicResource I18n.launchSettings.javaPriorityHint}" />
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="0,18,0,2"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource I18n.launchSettings.noJavaHint}" />
                    <ItemsControl
                        x:Name="JavaList"
                        Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate
                                DataType="{x:Type java:JavaInstallation}">
                                <Border
                                    x:Name="JavaRow"
                                    Style="{StaticResource InsetListRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.ColumnSpan="2"
                                            Margin="-12,-9"
                                            Background="{DynamicResource AccentHoverBrush}"
                                            CornerRadius="6"
                                            Style="{StaticResource VersionListHoverStyle}" />
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center">
                                            <StackPanel
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="Java " />
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Version}" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Text="{Binding Architecture}" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,4,8,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding Path}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Path}" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="JavaActions"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Style="{StaticResource VersionListActionsStyle}"
                                            VerticalAlignment="Center">
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="MoveUp_Click"
                                                Content="↑"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.launchSettings.moveUp}" />
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="MoveDown_Click"
                                                Content="↓"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.launchSettings.moveDown}" />
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="OpenFolder_Click"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.launchSettings.openContainingFolder}">
                                                <Path
                                                    Width="15"
                                                    Height="15"
                                                    Data="{x:Static icons:LauncherIcons.Folder}"
                                                    Stroke="{DynamicResource TextBrush}"
                                                    StrokeThickness="1.6"
                                                    StrokeLineJoin="Round" />
                                            </Button>
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="Remove_Click"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.common.removeFromList}">
                                                <Path
                                                    Width="12"
                                                    Height="12"
                                                    Data="{x:Static icons:LauncherIcons.Close}"
                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    StrokeThickness="1.5" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border
                        x:Name="MoreJavaClip"
                        Height="0"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                        <ItemsControl
                            x:Name="MoreJavaList" />
                    </Border>
                    <Button
                        x:Name="ExpandJavaButton"
                        Width="180"
                        Height="32"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        Click="ExpandJavaButton_Click"
                        Style="{StaticResource SecondaryActionStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
