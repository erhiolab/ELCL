<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.LaunchSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:java="clr-namespace:ErhioLab.Craft.Launcher.Core.Java;assembly=ErhioLab.Craft.Launcher.Core"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <controls:LauncherCard
                Header="{DynamicResource I18n.launchSettings.launchOptions}">
                <StackPanel>
                    <StackPanel
                        x:Name="VersionJavaPanel"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="155" />
                                <ColumnDefinition
                                    Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="Java" />
                            <ComboBox
                                x:Name="JavaModeBox"
                                Grid.Column="1"
                                SelectionChanged="JavaModeBox_SelectionChanged"
                                Style="{StaticResource FormComboBoxStyle}" />
                        </Grid>
                        <controls:AnimatedReveal
                            x:Name="SpecifiedJavaReveal">
                            <StackPanel
                                Margin="155,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="*" />
                                        <ColumnDefinition
                                            Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="SpecifiedJavaBox"
                                        SelectedValuePath="Path"
                                        SelectionChanged="SpecifiedJavaBox_SelectionChanged"
                                        Style="{StaticResource FormComboBoxStyle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate
                                                DataType="{x:Type java:JavaInstallation}">
                                                <TextBlock
                                                    Text="{Binding Path}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Path}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button
                                        x:Name="RefreshVersionJavaButton"
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Click="RefreshButton_Click"
                                        Style="{StaticResource SecondaryActionStyle}"
                                        ToolTip="{DynamicResource I18n.launchSettings.searchAgain}">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="{x:Static icons:LauncherIcons.Refresh}"
                                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            StrokeThickness="1.5"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            Stretch="Uniform" />
                                    </Button>
                                </Grid>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{DynamicResource I18n.versionLaunch.forcedJavaHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:AnimatedReveal>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource I18n.launchSettings.processPriority}" />
                        <ComboBox
                            x:Name="ProcessPriorityBox"
                            Grid.Column="1"
                            Height="Auto"
                            MinHeight="36"
                            SelectionChanged="ProcessPriorityBox_SelectionChanged"
                            Style="{StaticResource FormComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        MaxWidth="530"
                                        HorizontalAlignment="Left"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid
                        Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource I18n.launchSettings.windowSize}" />
                        <ComboBox
                            x:Name="WindowModeBox"
                            Grid.Column="1"
                            SelectionChanged="WindowModeBox_SelectionChanged"
                            Style="{StaticResource FormComboBoxStyle}">
                        </ComboBox>
                    </Grid>
                    <controls:AnimatedReveal
                        x:Name="CustomSizeReveal">
                        <Grid
                            Margin="155,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="12" />
                                <ColumnDefinition
                                    Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="{DynamicResource LabelFontSize}"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{DynamicResource I18n.launchSettings.windowWidth}" />
                                <TextBox
                                    x:Name="GameWindowWidthBox"
                                    MaxLength="5"
                                    TextChanged="WindowSizeBox_TextChanged"
                                    KeyDown="WindowSizeBox_KeyDown"
                                    LostFocus="WindowSizeBox_LostFocus"
                                    Style="{StaticResource FormTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="{DynamicResource LabelFontSize}"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{DynamicResource I18n.launchSettings.windowHeight}" />
                                <TextBox
                                    x:Name="GameWindowHeightBox"
                                    MaxLength="5"
                                    TextChanged="WindowSizeBox_TextChanged"
                                    KeyDown="WindowSizeBox_KeyDown"
                                    LostFocus="WindowSizeBox_LostFocus"
                                    Style="{StaticResource FormTextBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </controls:AnimatedReveal>
                    <Grid
                        Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource I18n.launchSettings.gameWindowTitle}" />
                        <TextBox
                            x:Name="GameWindowTitleBox"
                            Grid.Column="1"
                            MaxLength="512"
                            KeyDown="LaunchTitle_KeyDown"
                            LostFocus="LaunchText_LostFocus"
                            TextChanged="LaunchText_TextChanged"
                            Style="{StaticResource FormTextBoxStyle}"
                            ToolTip="{DynamicResource I18n.launchSettings.gameWindowTitleHint}" />
                    </Grid>
                    <TextBlock
                        x:Name="GameWindowTitlePreview"
                        Margin="155,5,0,0"
                        FontSize="{DynamicResource CaptionFontSize}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                Margin="0,14,0,0">
                <controls:LauncherCard.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{DynamicResource I18n.launchSettings.memoryAllocation}" />
                        <Button
                            x:Name="OptimizeMemoryButton"
                            Grid.Column="1"
                            Width="112"
                            Height="34"
                            Click="OptimizeMemoryButton_Click"
                            Content="{DynamicResource I18n.memoryOptimization.button}"
                            Style="{StaticResource SecondaryActionStyle}"
                            ToolTip="{DynamicResource I18n.memoryOptimization.hint}" />
                    </Grid>
                </controls:LauncherCard.Header>
                <StackPanel>
                    <RadioButton
                        x:Name="AutoMemoryButton"
                        GroupName="GameMemoryMode"
                        Content="{DynamicResource I18n.launchSettings.memoryAutomatic}"
                        Checked="MemoryMode_Checked" />
                    <Grid
                        Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="52" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="CustomMemoryButton"
                            VerticalAlignment="Center"
                            GroupName="GameMemoryMode"
                            Content="{DynamicResource I18n.launchSettings.memoryCustom}"
                            Checked="MemoryMode_Checked" />
                        <Slider
                            x:Name="MemoryPercentSlider"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            IsEnabled="{Binding IsChecked, ElementName=CustomMemoryButton}"
                            ValueChanged="MemoryPercentSlider_ValueChanged"
                            PreviewMouseLeftButtonUp="MemoryPercentSlider_Commit"
                            LostMouseCapture="MemoryPercentSlider_Commit"
                            LostKeyboardFocus="MemoryPercentSlider_Commit"
                            KeyUp="MemoryPercentSlider_KeyUp" />
                        <TextBlock
                            x:Name="MemoryPercentText"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentTextBrush}" />
                    </Grid>
                    <CheckBox
                        x:Name="OptimizeMemoryBeforeLaunchBox"
                        Checked="OptimizeMemoryBeforeLaunch_Changed"
                        Unchecked="OptimizeMemoryBeforeLaunch_Changed"
                        Margin="0,8,0,0"
                        Content="{DynamicResource I18n.memoryOptimization.beforeLaunch}"
                        ToolTip="{DynamicResource I18n.memoryOptimization.hint}"
                        Style="{StaticResource FormCheckBoxStyle}" />
                    <TextBlock
                        x:Name="MemoryModeHintText"
                        Margin="0,10,0,0"
                        FontSize="{DynamicResource LabelFontSize}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                    <Grid
                        Margin="0,18,0,0">
                        <TextBlock
                            x:Name="UsedMemoryTitle"
                            HorizontalAlignment="Left"
                            FontSize="{DynamicResource CaptionFontSize}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            SizeChanged="MemoryLabel_SizeChanged"
                            Text="{DynamicResource I18n.launchSettings.memoryUsed}" />
                        <Canvas
                            IsHitTestVisible="False">
                            <TextBlock
                                x:Name="GameMemoryTitle"
                                FontSize="{DynamicResource CaptionFontSize}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                SizeChanged="MemoryLabel_SizeChanged"
                                Text="{DynamicResource I18n.launchSettings.memoryGame}" />
                        </Canvas>
                    </Grid>
                    <controls:AnimatedSegmentBar
                        x:Name="MemoryUsageBar"
                        Height="6"
                        Margin="0,6,0,6"
                        FirstBrush="{DynamicResource MemoryUsedBrush}"
                        SecondBrush="{DynamicResource MemoryAllocatedBrush}"
                        ThirdBrush="{DynamicResource MemoryFreeBrush}"
                        FirstBoundaryChanged="MemoryUsageBar_FirstBoundaryChanged"
                        ToolTip="{DynamicResource I18n.launchSettings.memoryBarHint}" />
                    <Grid>
                        <TextBlock
                            x:Name="UsedMemoryText"
                            HorizontalAlignment="Left"
                            SizeChanged="MemoryLabel_SizeChanged" />
                        <Canvas
                            IsHitTestVisible="False">
                            <TextBlock
                                x:Name="GameMemoryText"
                                Foreground="{DynamicResource AccentTextBrush}"
                                SizeChanged="MemoryLabel_SizeChanged" />
                        </Canvas>
                    </Grid>
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                x:Name="JavaCatalogCard"
                Margin="0,14,0,0">
                <controls:LauncherCard.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Java" />
                            <TextBlock
                                x:Name="JavaCountText"
                                Margin="8,3,0,0"
                                FontSize="{DynamicResource CaptionFontSize}"
                                Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="1"
                            Width="96"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="RefreshButton_Click"
                            Content="{DynamicResource I18n.launchSettings.searchAgain}"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            x:Name="AddButton"
                            Grid.Column="2"
                            Width="96"
                            Height="34"
                            Click="AddButton_Click"
                            Content="{DynamicResource I18n.launchSettings.addManually}"
                            Style="{StaticResource SecondaryActionStyle}" />
                    </Grid>
                </controls:LauncherCard.Header>
                <StackPanel>
                    <TextBlock
                        FontSize="{DynamicResource LabelFontSize}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap"
                        Text="{DynamicResource I18n.launchSettings.javaPriorityHint}" />
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="0,18,0,2"
                        FontSize="{DynamicResource LabelFontSize}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource I18n.launchSettings.noJavaHint}" />
                    <ItemsControl
                        x:Name="JavaList"
                        Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate
                                DataType="{x:Type java:JavaInstallation}">
                                <Border
                                    x:Name="JavaRow"
                                    Style="{StaticResource InsetListRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.ColumnSpan="2"
                                            Margin="-12,-9"
                                            Background="{DynamicResource AccentHoverBrush}"
                                            CornerRadius="6"
                                            Style="{StaticResource VersionListHoverStyle}" />
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center">
                                            <StackPanel
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="{DynamicResource BodyFontSize}"
                                                    FontWeight="SemiBold"
                                                    Text="Java " />
                                                <TextBlock
                                                    FontSize="{DynamicResource BodyFontSize}"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Version}" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Text="{Binding Architecture}" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,4,8,0"
                                                FontSize="{DynamicResource CaptionFontSize}"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding Path}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Path}" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="JavaActions"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Style="{StaticResource VersionListActionsStyle}"
                                            VerticalAlignment="Center">
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="MoveUp_Click"
                                                Content="↑"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.launchSettings.moveUp}" />
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="MoveDown_Click"
                                                Content="↓"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.launchSettings.moveDown}" />
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="OpenFolder_Click"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.launchSettings.openContainingFolder}">
                                                <Path
                                                    Width="15"
                                                    Height="15"
                                                    Data="{x:Static icons:LauncherIcons.Folder}"
                                                    Stroke="{DynamicResource TextBrush}"
                                                    StrokeThickness="1.6"
                                                    StrokeLineJoin="Round" />
                                            </Button>
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="Remove_Click"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.common.removeFromList}">
                                                <Path
                                                    Width="12"
                                                    Height="12"
                                                    Data="{x:Static icons:LauncherIcons.Close}"
                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    StrokeThickness="1.5" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border
                        x:Name="MoreJavaClip"
                        Height="0"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                        <ItemsControl
                            x:Name="MoreJavaList" />
                    </Border>
                    <Button
                        x:Name="ExpandJavaButton"
                        Width="180"
                        Height="32"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        Click="ExpandJavaButton_Click"
                        Style="{StaticResource SecondaryActionStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </controls:LauncherCard>
            <Border
                Margin="0,14,0,0"
                Padding="0"
                Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <ToggleButton
                        x:Name="AdvancedOptionsToggle"
                        Content="{DynamicResource I18n.launchSettings.advancedOptions}"
                        Style="{StaticResource CardExpanderHeaderStyle}" />
                    <controls:AnimatedReveal
                        x:Name="AdvancedOptionsReveal"
                        IsExpanded="{Binding IsChecked, ElementName=AdvancedOptionsToggle}">
                        <StackPanel
                            Margin="20,0,20,20">
                            <Border
                                Height="1"
                                Margin="0,0,0,12"
                                Background="{DynamicResource LineSoftBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource I18n.launchSettings.jvmArguments}" />
                                    <Button
                                        Click="ResetJvmArguments_Click"
                                        Style="{StaticResource VersionActionStyle}"
                                        ToolTip="{DynamicResource I18n.launchSettings.resetJvmArguments}">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Data="{x:Static icons:LauncherIcons.Reset}"
                                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            StrokeThickness="1.5"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                                <TextBox
                                    x:Name="JvmArgumentsBox"
                                    Grid.Column="1"
                                    Height="96"
                                    MaxLength="16384"
                                    GotKeyboardFocus="LaunchText_GotKeyboardFocus"
                                    LostFocus="LaunchText_LostFocus"
                                    TextChanged="LaunchText_TextChanged"
                                    Style="{StaticResource FormMultilineTextBoxStyle}"
                                    ToolTip="{DynamicResource I18n.launchSettings.jvmArgumentsHint}" />
                            </Grid>
                            <Grid
                                Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.launchSettings.gameArguments}" />
                                <TextBox
                                    x:Name="GameArgumentsBox"
                                    Grid.Column="1"
                                    MaxLength="16384"
                                    GotKeyboardFocus="LaunchText_GotKeyboardFocus"
                                    KeyDown="LaunchTitle_KeyDown"
                                    LostFocus="LaunchText_LostFocus"
                                    TextChanged="LaunchText_TextChanged"
                                    Style="{StaticResource FormTextBoxStyle}"
                                    ToolTip="{DynamicResource I18n.launchSettings.gameArgumentsHint}" />
                            </Grid>
                            <Grid
                                Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.launchSettings.preLaunchCommand}" />
                                <TextBox
                                    x:Name="PreLaunchCommandBox"
                                    Grid.Column="1"
                                    Height="72"
                                    MaxLength="8192"
                                    GotKeyboardFocus="LaunchText_GotKeyboardFocus"
                                    LostFocus="LaunchText_LostFocus"
                                    TextChanged="LaunchText_TextChanged"
                                    Style="{StaticResource FormMultilineTextBoxStyle}"
                                    ToolTip="{DynamicResource I18n.launchSettings.preLaunchCommandHint}" />
                            </Grid>
                            <controls:AnimatedReveal
                                x:Name="WaitForCommandReveal">
                                <CheckBox
                                    x:Name="WaitForCommandBox"
                                    Checked="AdvancedChoice_Changed"
                                    Unchecked="AdvancedChoice_Changed"
                                    Margin="155,8,0,0"
                                    Content="{DynamicResource I18n.launchSettings.waitForCommand}"
                                    Style="{StaticResource FormCheckBoxStyle}" />
                            </controls:AnimatedReveal>
                            <Grid
                                Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="155" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.launchSettings.garbageCollector}" />
                                <ComboBox
                                    x:Name="GarbageCollectorBox"
                                    Grid.Column="1"
                                    SelectionChanged="GarbageCollectorBox_SelectionChanged"
                                    Style="{StaticResource FormComboBoxStyle}"
                                    ToolTip="{DynamicResource I18n.launchSettings.garbageCollectorHint}" />
                            </Grid>
                            <StackPanel
                                Margin="0,8,0,0">
                                <CheckBox
                                    x:Name="DisableJavaWrapperBox"
                                    Checked="AdvancedChoice_Changed"
                                    Unchecked="AdvancedChoice_Changed"
                                    Content="{DynamicResource I18n.launchSettings.disableJavaWrapper}"
                                    ToolTip="{DynamicResource I18n.launchSettings.disableJavaWrapperHint}"
                                    Style="{StaticResource FormCheckBoxStyle}" />
                                <CheckBox
                                    x:Name="DisableLwjglAgentBox"
                                    Checked="AdvancedChoice_Changed"
                                    Unchecked="AdvancedChoice_Changed"
                                    Content="{DynamicResource I18n.launchSettings.disableLwjglAgent}"
                                    ToolTip="{DynamicResource I18n.launchSettings.disableLwjglAgentHint}"
                                    Style="{StaticResource FormCheckBoxStyle}" />
                                <CheckBox
                                    x:Name="HighPerformanceGpuBox"
                                    Checked="AdvancedChoice_Changed"
                                    Unchecked="AdvancedChoice_Changed"
                                    Content="{DynamicResource I18n.launchSettings.highPerformanceGpu}"
                                    ToolTip="{DynamicResource I18n.launchSettings.highPerformanceGpuHint}"
                                    Style="{StaticResource FormCheckBoxStyle}" />
                                <CheckBox
                                    x:Name="VerifyCertificatesBox"
                                    Checked="AdvancedChoice_Changed"
                                    Unchecked="AdvancedChoice_Changed"
                                    Content="{DynamicResource I18n.launchSettings.verifyCertificates}"
                                    ToolTip="{DynamicResource I18n.launchSettings.verifyCertificatesHint}"
                                    Style="{StaticResource FormCheckBoxStyle}" />
                            </StackPanel>
                            <CheckBox
                                x:Name="SkipFileVerificationBox"
                                Margin="0,8,0,0"
                                Content="{DynamicResource I18n.versionLaunch.skipVerification}"
                                Checked="AdvancedChoice_Changed"
                                Unchecked="AdvancedChoice_Changed"
                                ToolTip="{DynamicResource I18n.versionLaunch.skipVerificationHint}"
                                Style="{StaticResource FormCheckBoxStyle}" />
                            <controls:AnimatedReveal
                                x:Name="PlaceholderPreviewReveal">
                                <StackPanel
                                    Margin="0,14,0,0">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="{DynamicResource LabelFontSize}"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{DynamicResource I18n.launchSettings.placeholderPreview}" />
                                    <TextBox
                                        x:Name="PlaceholderPreviewBox"
                                        Height="Auto"
                                        MinHeight="36"
                                        MaxHeight="120"
                                        IsReadOnly="True"
                                        IsTabStop="False"
                                        Style="{StaticResource FormMultilineTextBoxStyle}" />
                                    <TextBlock
                                        x:Name="UnknownPlaceholdersText"
                                        Margin="0,5,0,0"
                                        FontSize="{DynamicResource CaptionFontSize}"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:AnimatedReveal>
                        </StackPanel>
                    </controls:AnimatedReveal>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
