<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.LaunchSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:java="clr-namespace:ErhioLab.Craft.Launcher.Core.Java;assembly=ErhioLab.Craft.Launcher.Core"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="32,28,32,36">
            <controls:LauncherCard
                Header="{DynamicResource I18n.launchSettings.launchOptions}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource I18n.launchSettings.processPriority}" />
                        <ComboBox
                            x:Name="ProcessPriorityBox"
                            Grid.Column="1"
                            Height="Auto"
                            MinHeight="36"
                            HorizontalContentAlignment="Stretch"
                            SelectionChanged="ProcessPriorityBox_SelectionChanged"
                            Style="{StaticResource FormComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        MaxWidth="530"
                                        HorizontalAlignment="Left"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid
                        Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource I18n.launchSettings.windowSize}" />
                        <ComboBox
                            x:Name="WindowModeBox"
                            Grid.Column="1"
                            SelectionChanged="WindowModeBox_SelectionChanged"
                            Style="{StaticResource FormComboBoxStyle}">
                            <ComboBoxItem
                                Content="{DynamicResource I18n.launchSettings.windowFullscreen}" />
                            <ComboBoxItem
                                Content="{DynamicResource I18n.launchSettings.windowDefault}" />
                            <ComboBoxItem
                                Content="{DynamicResource I18n.launchSettings.windowMatchLauncher}" />
                            <ComboBoxItem
                                Content="{DynamicResource I18n.launchSettings.windowCustom}" />
                            <ComboBoxItem
                                Content="{DynamicResource I18n.launchSettings.windowMaximized}" />
                        </ComboBox>
                    </Grid>
                    <controls:AnimatedReveal
                        x:Name="CustomSizeReveal">
                        <Grid
                            Margin="155,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="12" />
                                <ColumnDefinition
                                    Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{DynamicResource I18n.launchSettings.windowWidth}" />
                                <TextBox
                                    x:Name="GameWindowWidthBox"
                                    MaxLength="5"
                                    KeyDown="WindowSizeBox_KeyDown"
                                    LostFocus="WindowSizeBox_LostFocus"
                                    Style="{StaticResource FormTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Text="{DynamicResource I18n.launchSettings.windowHeight}" />
                                <TextBox
                                    x:Name="GameWindowHeightBox"
                                    MaxLength="5"
                                    KeyDown="WindowSizeBox_KeyDown"
                                    LostFocus="WindowSizeBox_LostFocus"
                                    Style="{StaticResource FormTextBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </controls:AnimatedReveal>
                    <TextBlock
                        Margin="0,14,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource I18n.launchSettings.gameOptionsPending}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                Margin="0,14,0,0"
                Header="{DynamicResource I18n.launchSettings.memoryAllocation}">
                <StackPanel>
                    <RadioButton
                        x:Name="AutoMemoryButton"
                        GroupName="GameMemoryMode"
                        Content="{DynamicResource I18n.launchSettings.memoryAutomatic}"
                        Checked="MemoryMode_Checked" />
                    <Grid
                        Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="155" />
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="52" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="CustomMemoryButton"
                            VerticalAlignment="Center"
                            GroupName="GameMemoryMode"
                            Content="{DynamicResource I18n.launchSettings.memoryCustom}"
                            Checked="MemoryMode_Checked" />
                        <Slider
                            x:Name="MemoryPercentSlider"
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            IsEnabled="{Binding IsChecked, ElementName=CustomMemoryButton}"
                            ValueChanged="MemoryPercentSlider_ValueChanged"
                            PreviewMouseLeftButtonUp="MemoryPercentSlider_Commit"
                            LostMouseCapture="MemoryPercentSlider_Commit"
                            LostKeyboardFocus="MemoryPercentSlider_Commit"
                            KeyUp="MemoryPercentSlider_KeyUp" />
                        <TextBlock
                            x:Name="MemoryPercentText"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentTextBrush}" />
                    </Grid>
                    <TextBlock
                        x:Name="MemoryModeHintText"
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                    <Grid
                        Margin="0,18,0,0">
                        <TextBlock
                            x:Name="UsedMemoryTitle"
                            HorizontalAlignment="Left"
                            FontSize="11"
                            Foreground="{DynamicResource TextMutedBrush}"
                            SizeChanged="MemoryLabel_SizeChanged"
                            Text="{DynamicResource I18n.launchSettings.memoryUsed}" />
                        <Canvas
                            IsHitTestVisible="False">
                            <TextBlock
                                x:Name="GameMemoryTitle"
                                FontSize="11"
                                Foreground="{DynamicResource TextMutedBrush}"
                                SizeChanged="MemoryLabel_SizeChanged"
                                Text="{DynamicResource I18n.launchSettings.memoryGame}" />
                        </Canvas>
                    </Grid>
                    <controls:AnimatedSegmentBar
                        x:Name="MemoryUsageBar"
                        Height="6"
                        Margin="0,6,0,6"
                        FirstBrush="{DynamicResource MemoryUsedBrush}"
                        SecondBrush="{DynamicResource MemoryAllocatedBrush}"
                        ThirdBrush="{DynamicResource MemoryFreeBrush}"
                        FirstBoundaryChanged="MemoryUsageBar_FirstBoundaryChanged"
                        ToolTip="{DynamicResource I18n.launchSettings.memoryBarHint}" />
                    <Grid>
                        <TextBlock
                            x:Name="UsedMemoryText"
                            HorizontalAlignment="Left"
                            SizeChanged="MemoryLabel_SizeChanged" />
                        <Canvas
                            IsHitTestVisible="False">
                            <TextBlock
                                x:Name="GameMemoryText"
                                Foreground="{DynamicResource AccentTextBrush}"
                                SizeChanged="MemoryLabel_SizeChanged" />
                        </Canvas>
                    </Grid>
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                Margin="0,14,0,0">
                <controls:LauncherCard.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Java" />
                            <TextBlock
                                x:Name="JavaCountText"
                                Margin="8,3,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="1"
                            Width="96"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="RefreshButton_Click"
                            Content="{DynamicResource I18n.launchSettings.searchAgain}"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            x:Name="AddButton"
                            Grid.Column="2"
                            Width="96"
                            Height="34"
                            Click="AddButton_Click"
                            Content="{DynamicResource I18n.launchSettings.addManually}"
                            Style="{StaticResource SecondaryActionStyle}" />
                    </Grid>
                </controls:LauncherCard.Header>
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap"
                        Text="{DynamicResource I18n.launchSettings.javaPriorityHint}" />
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="0,18,0,2"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource I18n.launchSettings.noJavaHint}" />
                    <ItemsControl
                        x:Name="JavaList"
                        Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate
                                DataType="{x:Type java:JavaInstallation}">
                                <Border
                                    x:Name="JavaRow"
                                    Style="{StaticResource InsetListRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.ColumnSpan="2"
                                            Margin="-12,-9"
                                            Background="{DynamicResource AccentHoverBrush}"
                                            CornerRadius="6"
                                            Style="{StaticResource VersionListHoverStyle}" />
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center">
                                            <StackPanel
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="Java " />
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Version}" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Text="{Binding Architecture}" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,4,8,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding Path}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Path}" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="JavaActions"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Style="{StaticResource VersionListActionsStyle}"
                                            VerticalAlignment="Center">
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="MoveUp_Click"
                                                Content="↑"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.launchSettings.moveUp}" />
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="MoveDown_Click"
                                                Content="↓"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.launchSettings.moveDown}" />
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="OpenFolder_Click"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.launchSettings.openContainingFolder}">
                                                <Path
                                                    Width="15"
                                                    Height="15"
                                                    Data="{x:Static icons:LauncherIcons.Folder}"
                                                    Stroke="{DynamicResource TextBrush}"
                                                    StrokeThickness="1.6"
                                                    StrokeLineJoin="Round" />
                                            </Button>
                                            <Button
                                                Width="30"
                                                Height="30"
                                                Margin="3,0"
                                                Click="Remove_Click"
                                                Style="{StaticResource SecondaryActionStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource I18n.common.removeFromList}">
                                                <Path
                                                    Width="12"
                                                    Height="12"
                                                    Data="{x:Static icons:LauncherIcons.Close}"
                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    StrokeThickness="1.5" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border
                        x:Name="MoreJavaClip"
                        Height="0"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                        <ItemsControl
                            x:Name="MoreJavaList" />
                    </Border>
                    <Button
                        x:Name="ExpandJavaButton"
                        Width="180"
                        Height="32"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        Click="ExpandJavaButton_Click"
                        Style="{StaticResource SecondaryActionStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
