<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Settings.LaunchSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:java="clr-namespace:ErhioLab.Craft.Launcher.Core.Java;assembly=ErhioLab.Craft.Launcher.Core"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,36">
            <Border
                Padding="20"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Java" />
                            <TextBlock
                                x:Name="JavaCountText"
                                Margin="8,3,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="1"
                            Width="96"
                            Height="34"
                            Margin="0,0,8,0"
                            Click="RefreshButton_Click"
                            Content="重新获取"
                            Style="{StaticResource SecondaryActionStyle}" />
                        <Button
                            x:Name="AddButton"
                            Grid.Column="2"
                            Width="96"
                            Height="34"
                            Click="AddButton_Click"
                            Content="手动添加"
                            Style="{StaticResource SecondaryActionStyle}" />
                    </Grid>
                    <Border Height="1" Margin="0,13,0,12" Background="{DynamicResource LineSoftBrush}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap"
                        Text="启动游戏时, ELCL 会选择列表中第一个兼容当前 Minecraft 的 Java. 点击选项右侧的箭头可以进行排序, 以控制优先选择哪个 Java. 若想无视兼容性, 强制使用某个 Java, 请在版本独立设置中修改." />
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="0,18,0,2"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="尚未找到 Java, 可以手动获取或添加 java.exe." />
                    <ItemsControl x:Name="JavaList" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type java:JavaInstallation}">
                                <Border
                                    x:Name="JavaRow"
                                    Margin="0,0,0,8"
                                    Padding="12,9"
                                    Background="{DynamicResource InkRaisedBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="Java " />
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Version}" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Text="{Binding Architecture}" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,4,8,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding Path}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Path}" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="JavaActions"
                                            Grid.Column="1"
                                            IsHitTestVisible="False"
                                            Opacity="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                            <Button Width="30" Height="30" Margin="3,0" Click="MoveUp_Click"
                                                    Content="↑" Style="{StaticResource SecondaryActionStyle}"
                                                    Tag="{Binding}" ToolTip="上移" />
                                            <Button Width="30" Height="30" Margin="3,0" Click="MoveDown_Click"
                                                    Content="↓" Style="{StaticResource SecondaryActionStyle}"
                                                    Tag="{Binding}" ToolTip="下移" />
                                            <Button Width="30" Height="30" Margin="3,0" Click="OpenFolder_Click"
                                                    Style="{StaticResource SecondaryActionStyle}" Tag="{Binding}"
                                                    ToolTip="打开所在文件夹">
                                                <Path
                                                    Width="15"
                                                    Height="15"
                                                    Data="{x:Static icons:LauncherIcons.Folder}"
                                                    Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"
                                                    StrokeLineJoin="Round" />
                                            </Button>
                                            <Button Width="30" Height="30" Margin="3,0" Click="Remove_Click"
                                                    Content="×" Style="{StaticResource SecondaryActionStyle}"
                                                    Tag="{Binding}" ToolTip="从列表移除" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="JavaRow" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="JavaActions" Property="IsHitTestVisible" Value="True" />
                                        <Setter TargetName="JavaActions" Property="Opacity" Value="1" />
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="JavaActions"
                                                                     Storyboard.TargetProperty="Opacity" To="1"
                                                                     Duration="0:0:0.14" FillBehavior="Stop" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="JavaActions"
                                                                     Storyboard.TargetProperty="Opacity" To="0"
                                                                     Duration="0:0:0.12" FillBehavior="Stop" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger SourceName="JavaRow" Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="JavaActions" Property="IsHitTestVisible" Value="True" />
                                        <Setter TargetName="JavaActions" Property="Opacity" Value="1" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border
                        x:Name="MoreJavaClip"
                        Height="0"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                        <ItemsControl x:Name="MoreJavaList" />
                    </Border>
                    <Button
                        x:Name="ExpandJavaButton"
                        Width="180"
                        Height="32"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        Click="ExpandJavaButton_Click"
                        Style="{StaticResource SecondaryActionStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
