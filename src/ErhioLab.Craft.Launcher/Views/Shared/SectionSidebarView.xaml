<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Shared.SectionSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Sidebar_Loaded">
    <Grid Margin="20,24">
        <Border
            x:Name="SelectionHighlight"
            Height="46"
            VerticalAlignment="Top"
            Background="{DynamicResource AccentMutedBrush}"
            CornerRadius="6"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SelectionHighlightOffset" />
            </Border.RenderTransform>
        </Border>
        <ItemsControl x:Name="NavigationItems">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="NavigationRow">
                        <RadioButton
                            Checked="NavigationItem_Checked"
                            Content="{Binding Title}"
                            GroupName="SectionNavigation"
                            IsChecked="{Binding IsFirst, Mode=OneTime}"
                            Loaded="NavigationItem_Loaded"
                            Style="{StaticResource SectionNavigationStyle}" />
                        <Button
                            x:Name="ResetButton"
                            Width="26"
                            Height="26"
                            Margin="0,0,10,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="ResetButton_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Style="{StaticResource SidebarResetButtonStyle}"
                            Tag="{Binding Item}"
                            ToolTip="重置个性化设置"
                            Visibility="Collapsed">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE777;" />
                        </Button>
                    </Grid>
                    <DataTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanReset}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, ElementName=NavigationRow}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ResetButton" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border
            x:Name="SidebarIndicator"
            Width="2"
            Height="20"
            Margin="18,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{DynamicResource AccentBrush}"
            CornerRadius="1"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SidebarIndicatorOffset" />
            </Border.RenderTransform>
        </Border>
    </Grid>
</UserControl>
