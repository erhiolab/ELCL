<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Shared.SectionSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                x:Name="SectionCodeText"
                FontFamily="{StaticResource MonoFont}"
                FontSize="9"
                Foreground="{StaticResource AccentBrush}" />
            <TextBlock
                x:Name="SectionTitleText"
                Margin="0,8,0,0"
                FontFamily="{StaticResource DisplayFont}"
                FontSize="22"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="SectionDescriptionText"
                Margin="0,6,0,0"
                FontSize="11"
                Foreground="{StaticResource TextMutedBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ItemsControl x:Name="NavigationItems" Grid.Row="2">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton
                        Content="{Binding Title}"
                        GroupName="SectionNavigation"
                        IsChecked="{Binding IsFirst, Mode=OneTime}"
                        Style="{StaticResource SectionNavigationStyle}"
                        Tag="{Binding Index}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>