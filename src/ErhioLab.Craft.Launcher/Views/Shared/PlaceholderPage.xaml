<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Shared.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource InkBrush}">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">
            <TextBlock
                x:Name="PageCodeText"
                FontFamily="{StaticResource MonoFont}"
                FontSize="10"
                Foreground="{DynamicResource AccentBrush}" />
            <TextBlock
                x:Name="PageTitleText"
                Margin="0,12,0,0"
                FontFamily="{StaticResource DisplayFont}"
                FontSize="34"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="PageDescriptionText"
                Width="440"
                Margin="0,12,0,0"
                HorizontalAlignment="Left"
                FontSize="13"
                Foreground="{DynamicResource TextMutedBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>