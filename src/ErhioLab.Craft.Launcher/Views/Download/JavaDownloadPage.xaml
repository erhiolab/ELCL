<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Download.JavaDownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:local="clr-namespace:ErhioLab.Craft.Launcher.Views.Download"
    Background="{DynamicResource InkBrush}"
    Foreground="{DynamicResource TextBrush}"
    Loaded="Page_Loaded">
    <Grid
        Margin="{StaticResource FormPageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <controls:LauncherCard
            Margin="0,0,0,14"
            Header="{DynamicResource I18n.javaDownload.title}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="DeviceText"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Click="Refresh_Click"
                        Content="{DynamicResource I18n.javaDownload.refresh}"
                        Style="{StaticResource CompactActionButtonStyle}" />
                </Grid>
                <Grid
                    Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="16" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Foreground="{DynamicResource TextBrush}"
                            Text="{DynamicResource I18n.javaDownload.distribution}" />
                        <ComboBox
                            x:Name="SourcesBox"
                            SelectionChanged="Source_Changed"
                            Style="{StaticResource FormComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate
                                    DataType="{x:Type local:JavaProviderOption}">
                                    <TextBlock
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2">
                        <TextBlock
                            Margin="0,0,0,8"
                            Foreground="{DynamicResource TextBrush}"
                            Text="{DynamicResource I18n.javaDownload.major}" />
                        <ComboBox
                            x:Name="MajorsBox"
                            SelectionChanged="Major_Changed"
                            Style="{StaticResource FormComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate
                                    DataType="{x:Type local:JavaMajorOption}">
                                    <TextBlock
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock
                    x:Name="SourceStateText"
                    Margin="0,10,0,0"
                    Foreground="{DynamicResource TextMutedBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:LauncherCard>
        <Border
            Grid.Row="1"
            Padding="12"
            Style="{StaticResource PanelCardStyle}">
            <Grid>
                <ListBox
                    x:Name="VersionsList"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionMode="Single"
                    SelectionChanged="Version_Changed"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style
                            TargetType="ListBoxItem"
                            BasedOn="{StaticResource SelectableListRowStyle}">
                            <Setter
                                Property="Height"
                                Value="64" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate
                            DataType="{x:Type local:JavaDownloadRow}">
                            <Grid
                                ToolTip="{Binding Version.Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,5,12,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentMutedBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Text="{Binding FormatLabel}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                    x:Name="EmptyText"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource I18n.javaDownload.loading}"
                    TextWrapping="Wrap"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>
        <WrapPanel
            Grid.Row="2"
            Margin="0,14,0,0"
            HorizontalAlignment="Center">
            <Button
                x:Name="MoreButton"
                MinWidth="120"
                Height="38"
                Margin="0,0,10,0"
                Click="More_Click"
                Content="{DynamicResource I18n.javaDownload.more}"
                IsEnabled="False"
                Style="{StaticResource SecondaryActionStyle}" />
            <Button
                x:Name="DownloadButton"
                MinWidth="150"
                Height="38"
                Click="Download_Click"
                Content="{DynamicResource I18n.javaDownload.install}"
                IsEnabled="False"
                Style="{StaticResource PrimaryActionStyle}" />
        </WrapPanel>
    </Grid>
</UserControl>
