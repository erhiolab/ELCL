<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Download.VanillaVersionDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    Background="{DynamicResource InkBrush}"
    Loaded="Page_Loaded">
    <UserControl.Resources>
        <!-- 输入框的背景和边框由外层容器绘制. -->
        <Style x:Key="VersionNameInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Background="Transparent"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailsBackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid>
                                <Border
                                    Background="{DynamicResource AccentHoverBrush}"
                                    CornerRadius="6"
                                    Style="{StaticResource HoverLayerStyle}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LoaderHeaderStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderRoot" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <Border
                                    Background="{DynamicResource AccentHoverBrush}"
                                    CornerRadius="8"
                                    Style="{StaticResource HoverLayerStyle}" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter
                                    TargetName="HeaderRoot"
                                    Property="Background"
                                    Value="{DynamicResource AccentMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LoaderStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="#FFE5484D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoaderChoiceStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="0,0,4,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{DynamicResource InkRaisedBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Border
                                    Background="{DynamicResource AccentHoverBrush}"
                                    CornerRadius="6"
                                    Style="{StaticResource HoverLayerStyle}" />
                                <ContentPresenter Margin="14,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentMutedBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,24,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Height="70"
            Padding="12,0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Click="BackButton_Click"
                    Style="{StaticResource DetailsBackButtonStyle}"
                    ToolTip="返回版本列表">
                    <TextBlock
                        FontFamily="{x:Static icons:LauncherIcons.GlyphFont}"
                        FontSize="18"
                        Text="{x:Static icons:LauncherIcons.Back}" />
                </Button>
                <Path
                    x:Name="VersionIcon"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Stroke="{DynamicResource AccentTextBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6"
                    Stretch="Uniform" />
                <Border
                    Grid.Column="2"
                    Height="36"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource InkRaisedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBox
                        x:Name="VersionNameBox"
                        VerticalContentAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextBrush}"
                        Style="{StaticResource VersionNameInputStyle}"
                        ToolTip="可自定义下载后的版本名称" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,22,0,0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl
                ItemsSource="{Binding LoaderSections, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,10"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <ToggleButton
                                    Click="LoaderHeader_Click"
                                    Style="{StaticResource LoaderHeaderStyle}"
                                    Tag="{Binding ElementName=LoaderContent}">
                                    <Grid Margin="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextBrush}"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Style="{StaticResource LoaderStatusStyle}"
                                            Text="{Binding StatusText}" />
                                        <Path
                                            Grid.Column="2"
                                            Width="10"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Stroke="{DynamicResource TextMutedBrush}"
                                            StrokeThickness="1.5">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="M 1,1 L 5,5 L 9,1" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasVersions}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Data" Value="M 1,5 L 5,1 L 9,5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </ToggleButton>
                                <Border
                                    x:Name="LoaderContent"
                                    Height="0"
                                    ClipToBounds="True"
                                    Loaded="LoaderContent_Loaded">
                                    <ListBox
                                        MaxHeight="230"
                                        Margin="10,0,8,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource TextBrush}"
                                        ItemContainerStyle="{StaticResource LoaderChoiceStyle}"
                                        ItemsSource="{Binding Choices}"
                                        ScrollViewer.CanContentScroll="True"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectionChanged="LoaderChoice_SelectionChanged"
                                        Tag="{Binding}"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextBrush}"
                                                            Text="{Binding Label}" />
                                                        <TextBlock
                                                            Margin="0,3,0,0"
                                                            FontSize="11"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            Text="{Binding Detail}" />
                                                    </StackPanel>
                                                    <Border
                                                        x:Name="VersionBadge"
                                                        Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentMutedBrush}"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            x:Name="BadgeText"
                                                            FontSize="10"
                                                            Foreground="{DynamicResource AccentTextBrush}"
                                                            Text="正式版" />
                                                    </Border>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                                        <Setter TargetName="BadgeText" Property="Text" Value="预览版" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNone}" Value="True">
                                                        <Setter TargetName="VersionBadge" Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button
            Grid.Row="2"
            Width="150"
            Height="44"
            HorizontalAlignment="Center"
            Click="StartDownloadButton_Click"
            Style="{StaticResource PrimaryActionStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{x:Static icons:LauncherIcons.GlyphFont}"
                    FontSize="17"
                    Text="{x:Static icons:LauncherIcons.Download}" />
                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13" Text="开始下载" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
