<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Download.VanillaVersionDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    Background="{DynamicResource InkBrush}">
    <UserControl.Resources>
        <!-- 输入框的背景和边框由外层容器绘制. -->
        <Style x:Key="VersionNameInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Background="Transparent"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DetailsBackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Grid>
                                <Border
                                    Background="{DynamicResource AccentHoverBrush}"
                                    CornerRadius="6"
                                    Style="{StaticResource HoverLayerStyle}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,24,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Height="70"
            Padding="12,0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Click="BackButton_Click"
                    Style="{StaticResource DetailsBackButtonStyle}"
                    ToolTip="返回版本列表">
                    <TextBlock
                        FontFamily="{x:Static icons:LauncherIcons.GlyphFont}"
                        FontSize="18"
                        Text="{x:Static icons:LauncherIcons.Back}" />
                </Button>
                <Path
                    x:Name="VersionIcon"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Stroke="{DynamicResource AccentTextBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6"
                    Stretch="Uniform" />
                <Border
                    Grid.Column="2"
                    Height="36"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource InkRaisedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBox
                        x:Name="VersionNameBox"
                        VerticalContentAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextBrush}"
                        Style="{StaticResource VersionNameInputStyle}"
                        ToolTip="可自定义下载后的版本名称" />
                </Border>
            </Grid>
        </Border>

        <ItemsControl
            Grid.Row="1"
            Margin="0,22,0,0"
            ItemsSource="{Binding LoaderNames, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Height="48"
                        Margin="0,0,0,10"
                        Padding="16,0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{Binding}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="无" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button
            Grid.Row="2"
            Width="150"
            Height="44"
            HorizontalAlignment="Center"
            Click="StartDownloadButton_Click"
            Style="{StaticResource PrimaryActionStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{x:Static icons:LauncherIcons.GlyphFont}"
                    FontSize="17"
                    Text="{x:Static icons:LauncherIcons.Download}" />
                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13" Text="开始下载" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
