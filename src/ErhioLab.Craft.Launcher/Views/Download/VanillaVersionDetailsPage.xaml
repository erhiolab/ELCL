<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Download.VanillaVersionDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    Background="{DynamicResource InkBrush}"
    Loaded="Page_Loaded">
    <UserControl.Resources>
        <!-- 输入框的背景和边框由外层容器绘制. -->
        <Style
            x:Key="LoaderHeaderStyle"
            TargetType="ToggleButton">
            <Setter
                Property="Height"
                Value="48" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="ToggleButton">
                        <Border
                            x:Name="HeaderRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <Grid>
                                <Border
                                    Background="{DynamicResource AccentHoverBrush}"
                                    CornerRadius="8"
                                    Style="{StaticResource HoverLayerStyle}" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsChecked"
                                Value="True">
                                <Setter
                                    TargetName="HeaderRoot"
                                    Property="Background"
                                    Value="{DynamicResource AccentMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="LoaderStatusStyle"
            TargetType="TextBlock">
            <Setter
                Property="Foreground"
                Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding HasError}"
                    Value="True">
                    <Setter
                        Property="Foreground"
                        Value="#FFE5484D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid
        Margin="{StaticResource FormPageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Height="70"
            Padding="12,0"
            Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="42" />
                    <ColumnDefinition
                        Width="42" />
                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Click="BackButton_Click"
                    Style="{StaticResource DetailsBackButtonStyle}"
                    ToolTip="{DynamicResource I18n.versionDetails.backToVersionList}">
                    <Path
                        Width="18"
                        Height="18"
                        Data="{x:Static icons:LauncherIcons.Back}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        Stretch="Uniform" />
                </Button>
                <Path
                    x:Name="VersionIcon"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Stroke="{DynamicResource AccentTextBrush}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6"
                    Stretch="Uniform" />
                <Border
                    Grid.Column="2"
                    Height="36"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource InkRaisedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBox
                        x:Name="VersionNameBox"
                        VerticalContentAlignment="Center"
                        FontSize="{DynamicResource BodyFontSize}"
                        Foreground="{DynamicResource TextBrush}"
                        Style="{StaticResource BareTextBoxStyle}"
                        ToolTip="{DynamicResource I18n.versionDetails.versionNameHint}" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,22,0,0"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl
                ItemsSource="{Binding LoaderSections, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,10"
                            CornerRadius="8"
                            Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <ToggleButton
                                    Click="LoaderHeader_Click"
                                    Style="{StaticResource LoaderHeaderStyle}"
                                    Tag="{Binding ElementName=LoaderContent}">
                                    <Grid
                                        Margin="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="36" />
                                            <ColumnDefinition
                                                Width="114" />
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="20" />
                                        </Grid.ColumnDefinitions>
                                        <Path
                                            Width="18"
                                            Height="18"
                                            VerticalAlignment="Center"
                                            Data="{Binding Icon}"
                                            Stroke="{DynamicResource AccentTextBrush}"
                                            StrokeThickness="1.3"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource BodyFontSize}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextBrush}"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource LabelFontSize}"
                                            Style="{StaticResource LoaderStatusStyle}"
                                            Text="{Binding StatusText}" />
                                        <Path
                                            Grid.Column="3"
                                            Width="10"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Stroke="{DynamicResource TextMutedBrush}"
                                            StrokeThickness="1.5">
                                            <Path.Style>
                                                <Style
                                                    TargetType="Path">
                                                    <Setter
                                                        Property="Data"
                                                        Value="M 1,1 L 5,5 L 9,1" />
                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding HasVersions}"
                                                            Value="True">
                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding IsExpanded}"
                                                            Value="True">
                                                            <Setter
                                                                Property="Data"
                                                                Value="M 1,5 L 5,1 L 9,5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </ToggleButton>
                                <Border
                                    x:Name="LoaderContent"
                                    Height="0"
                                    ClipToBounds="True"
                                    Loaded="LoaderContent_Loaded">
                                    <ListBox
                                        MaxHeight="230"
                                        Margin="10,0,8,8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource TextBrush}"
                                        ItemContainerStyle="{StaticResource SelectableListRowStyle}"
                                        ItemsSource="{Binding Choices}"
                                        ScrollViewer.CanContentScroll="True"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectionChanged="LoaderChoice_SelectionChanged"
                                        Tag="{Binding}"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
                                                            Width="*" />
                                                        <ColumnDefinition
                                                            Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="{DynamicResource BodyFontSize}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextBrush}"
                                                            Text="{Binding Label}" />
                                                        <TextBlock
                                                            Margin="0,3,0,0"
                                                            FontSize="{DynamicResource CaptionFontSize}"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            Text="{Binding Detail}" />
                                                    </StackPanel>
                                                    <Border
                                                        x:Name="VersionBadge"
                                                        Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentMutedBrush}"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            x:Name="BadgeText"
                                                            FontSize="{DynamicResource SmallFontSize}"
                                                            Foreground="{DynamicResource AccentTextBrush}"
                                                            Text="{DynamicResource I18n.version.release}" />
                                                    </Border>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsPreview}"
                                                        Value="True">
                                                        <Setter
                                                            TargetName="BadgeText"
                                                            Property="Text"
                                                            Value="{DynamicResource I18n.version.preview}" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsNone}"
                                                        Value="True">
                                                        <Setter
                                                            TargetName="VersionBadge"
                                                            Property="Visibility"
                                                            Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button
            Grid.Row="2"
            Width="150"
            Height="44"
            HorizontalAlignment="Center"
            Click="StartDownloadButton_Click"
            Style="{StaticResource PrimaryActionStyle}">
            <StackPanel
                Orientation="Horizontal">
                <Path
                    VerticalAlignment="Center"
                    Width="17"
                    Height="17"
                    Data="{x:Static icons:LauncherIcons.Download}"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                    StrokeThickness="1.5"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Stretch="Uniform" />
                <TextBlock
                    Margin="9,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource BodyFontSize}"
                    Text="{DynamicResource I18n.common.startDownload}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
