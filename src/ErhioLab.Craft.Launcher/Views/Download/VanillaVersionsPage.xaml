<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Download.VanillaVersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:download="clr-namespace:ErhioLab.Craft.Launcher.Views.Download"
    Background="{DynamicResource InkBrush}"
    Loaded="Page_Loaded">
    <UserControl.Resources>
        <!-- 搜索输入框只显示文字和光标, 外观由外层 Border 绘制. -->
        <!-- 折叠区只使用一层卡片, 内容高度由代码平滑改变. -->
        <Style
            x:Key="VersionGroupHeaderStyle"
            TargetType="ToggleButton">
            <Setter
                Property="Height"
                Value="42" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="Foreground"
                Value="{DynamicResource TextBrush}" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="ToggleButton">
                        <Border
                            x:Name="HeaderRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <Grid>
                                <Border
                                    Background="{DynamicResource AccentHoverBrush}"
                                    CornerRadius="8"
                                    Style="{StaticResource HoverLayerStyle}" />
                                <Grid
                                    Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="*" />
                                        <ColumnDefinition
                                            Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter
                                        VerticalAlignment="Center" />
                                    <Path
                                        x:Name="Chevron"
                                        Grid.Column="1"
                                        Width="10"
                                        Height="6"
                                        VerticalAlignment="Center"
                                        Data="M 1,1 L 5,5 L 9,1"
                                        Stroke="{DynamicResource TextMutedBrush}"
                                        StrokeThickness="1.5" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsChecked"
                                Value="True">
                                <Setter
                                    TargetName="Chevron"
                                    Property="Data"
                                    Value="M 1,5 L 5,1 L 9,5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate
            x:Key="VersionTemplate"
            DataType="{x:Type download:VanillaVersionsPage+VersionRow}">
            <Border
                x:Name="VersionRow"
                Style="{StaticResource VersionListRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="34" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 高亮层的透明度缓动, 不改变列表行的布局. -->
                    <Border
                        x:Name="VersionRowHover"
                        Grid.ColumnSpan="3"
                        Margin="-8,0"
                        Background="{DynamicResource AccentMutedBrush}"
                        CornerRadius="6"
                        Style="{StaticResource VersionListHoverStyle}" />
                    <Path
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Data="{Binding Icon}"
                        Stroke="{DynamicResource AccentTextBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.6"
                        Stretch="Uniform" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{Binding Version.Id}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="10"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{Binding Description}" />
                    </StackPanel>
                    <StackPanel
                        x:Name="RowActions"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Style="{StaticResource VersionListActionsStyle}">
                        <Button
                            Click="ChangelogButton_Click"
                            MouseEnter="ChangelogButton_MouseEnter"
                            Style="{StaticResource VersionActionStyle}"
                            Tag="{Binding}"
                            ToolTipService.InitialShowDelay="500">
                            <Button.ToolTip>
                                <ToolTip
                                    MaxWidth="440"
                                    Content="{Binding TooltipText}" />
                            </Button.ToolTip>
                            <Path
                                Width="15"
                                Height="15"
                                Data="{x:Static icons:LauncherIcons.Info}"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                                StrokeThickness="1.5"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <Border
                Height="42"
                Margin="0,0,0,14"
                CornerRadius="8"
                Style="{StaticResource PanelCardStyle}">
                <Grid
                    Margin="13,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="24" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="28" />
                    </Grid.ColumnDefinitions>
                    <Path
                        VerticalAlignment="Center"
                        Width="15"
                        Height="15"
                        Data="{x:Static icons:LauncherIcons.Search}"
                        Stroke="{DynamicResource TextMutedBrush}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        Stretch="Uniform" />
                    <Grid
                        Grid.Column="1">
                        <TextBox
                            x:Name="VersionSearchBox"
                            VerticalContentAlignment="Center"
                            CaretBrush="{DynamicResource AccentBrush}"
                            FontSize="12"
                            Foreground="{DynamicResource TextBrush}"
                            KeyDown="VersionSearchBox_KeyDown"
                            Style="{StaticResource BareTextBoxStyle}"
                            TextChanged="VersionSearchBox_TextChanged" />
                        <TextBlock
                            x:Name="SearchHint"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextMutedBrush}"
                            IsHitTestVisible="False"
                            Text="{DynamicResource I18n.versionCatalog.searchPlaceholder}" />
                    </Grid>
                    <Button
                        x:Name="ClearSearchButton"
                        Grid.Column="2"
                        Click="ClearSearchButton_Click"
                        Style="{StaticResource VersionActionStyle}"
                        ToolTip="{DynamicResource I18n.versionCatalog.clearSearch}"
                        Visibility="Collapsed">
                        <Path
                            Width="12"
                            Height="12"
                            Data="{x:Static icons:LauncherIcons.Close}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>
            <TextBlock
                x:Name="EmptySearchText"
                Margin="2,14"
                Foreground="{DynamicResource TextMutedBrush}"
                Text="{DynamicResource I18n.versionCatalog.noMatches}"
                Visibility="Collapsed" />
            <ItemsControl
                x:Name="VersionGroups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate
                        DataType="{x:Type download:VanillaVersionsPage+VersionGroup}">
                        <Border
                            Margin="0,0,0,12"
                            Style="{StaticResource PanelCardStyle}">
                            <StackPanel>
                                <ToggleButton
                                    Click="GroupHeader_Click"
                                    Content="{Binding Title}"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    IsChecked="{Binding IsInitiallyExpanded, Mode=OneTime}"
                                    Style="{StaticResource VersionGroupHeaderStyle}"
                                    Tag="{Binding ElementName=GroupContent}" />
                                <Border
                                    x:Name="GroupContent"
                                    Height="0"
                                    ClipToBounds="True"
                                    Loaded="GroupContent_Loaded">
                                    <ListBox
                                        MaxHeight="430"
                                        Margin="12,0,12,12"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource TextBrush}"
                                        ItemTemplate="{StaticResource VersionTemplate}"
                                        ItemsSource="{Binding Versions}"
                                        SelectionChanged="VersionList_SelectionChanged"
                                        ScrollViewer.CanContentScroll="True"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling"
                                        ItemContainerStyle="{StaticResource PlainListBoxItemStyle}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
