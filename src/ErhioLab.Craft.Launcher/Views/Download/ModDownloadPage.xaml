<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Download.ModDownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    Foreground="{DynamicResource TextBrush}"
    Background="{DynamicResource PageSurfaceBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid
        Margin="{StaticResource FormPageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Padding="18,16"
            Margin="0,0,0,12"
            Style="{StaticResource PanelCardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="156" />
                        <ColumnDefinition
                            Width="88" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Margin="0,0,12,0">
                        <TextBlock
                            x:Name="QueryLabel"
                            Text="{DynamicResource I18n.mods.name}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="{DynamicResource CaptionFontSize}"
                            Margin="0,0,0,6" />
                        <TextBox
                            x:Name="QueryBox"
                            Style="{StaticResource FormTextBoxStyle}"
                            KeyDown="Query_KeyDown" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,12,0">
                        <TextBlock
                            Text="{DynamicResource I18n.mods.source}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="{DynamicResource CaptionFontSize}"
                            Margin="0,0,0,6" />
                        <ComboBox
                            x:Name="SourcesBox"
                            Style="{StaticResource FormComboBoxStyle}"
                            SelectionChanged="Filter_Changed">
                            <ComboBoxItem
                                Content="{DynamicResource I18n.mods.all}" />
                            <ComboBoxItem
                                Content="CurseForge" />
                            <ComboBoxItem
                                Content="Modrinth" />
                        </ComboBox>
                    </StackPanel>
                    <Button
                        x:Name="SearchButton"
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Content="{DynamicResource I18n.mods.search}"
                        Style="{StaticResource PrimaryActionStyle}"
                        Click="Search_Click"
                        Height="34" />
                    <Button
                        x:Name="ResetFiltersButton"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Padding="12,0"
                        VerticalAlignment="Bottom"
                        Content="{DynamicResource I18n.mods.resetFilters}"
                        Style="{StaticResource SecondaryActionStyle}"
                        Click="ResetFilters_Click"
                        Height="34" />
                </Grid>
                <Grid
                    Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="2*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:AnimatedFilterPair
                        x:Name="LoaderPair"
                        Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock
                                Text="{DynamicResource I18n.mods.gameVersion}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="{DynamicResource CaptionFontSize}"
                                Margin="0,0,0,6" />
                            <controls:GameVersionComboBox
                                x:Name="GameVersionBox"
                                LostKeyboardFocus="Version_LostFocus"
                                SelectionChanged="Version_Changed"
                                KeyDown="Query_KeyDown" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock
                                Text="{DynamicResource I18n.mods.loader}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="{DynamicResource CaptionFontSize}"
                                Margin="0,0,0,6" />
                            <ComboBox
                                x:Name="LoaderBox"
                                Style="{StaticResource FormComboBoxStyle}"
                                SelectionChanged="Filter_Changed" />
                        </StackPanel>
                    </controls:AnimatedFilterPair>
                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,12,0">
                        <TextBlock
                            Text="{DynamicResource I18n.mods.category}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="{DynamicResource CaptionFontSize}"
                            Margin="0,0,0,6" />
                        <ComboBox
                            x:Name="CategoryBox"
                            Style="{StaticResource FormComboBoxStyle}"
                            SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2">
                        <TextBlock
                            Text="{DynamicResource I18n.mods.sort}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="{DynamicResource CaptionFontSize}"
                            Margin="0,0,0,6" />
                        <ComboBox
                            x:Name="SortBox"
                            Style="{StaticResource FormComboBoxStyle}"
                            ToolTip="{DynamicResource I18n.community.sortHint}"
                            SelectionChanged="Filter_Changed">
                            <ComboBoxItem
                                Content="{DynamicResource I18n.mods.sortDefault}" />
                            <ComboBoxItem
                                Content="{DynamicResource I18n.mods.sortDownloads}" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <Border
            Grid.Row="1"
            Padding="8"
            Style="{StaticResource PanelCardStyle}">
            <Grid>
                <ListBox
                    x:Name="ResultsList"
                    Background="Transparent"
                    BorderThickness="0"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    MouseLeftButtonUp="Result_Click"
                    PreviewKeyDown="Result_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style
                            TargetType="ListBoxItem"
                            BasedOn="{StaticResource SelectableListRowStyle}">
                            <Setter
                                Property="Height"
                                Value="72" />
                            <Setter
                                Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:ModProjectCard />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                    x:Name="EmptyText"
                    Text="{DynamicResource I18n.mods.empty}"
                    Foreground="{DynamicResource TextMutedBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>
        <Border
            x:Name="PaginationBar"
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="12,8"
            Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ResultStatus"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextBrush}"
                    TextWrapping="Wrap" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="PreviousButton"
                        Content="{DynamicResource I18n.mods.previous}"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Click="Previous_Click"
                        IsEnabled="False" />
                    <TextBlock
                        x:Name="PageText"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextBrush}" />
                    <Button
                        x:Name="NextButton"
                        Content="{DynamicResource I18n.mods.next}"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Click="Next_Click"
                        IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
