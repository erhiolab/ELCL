<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.More.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <controls:LauncherCard
                Margin="0,0,0,14"
                Header="{DynamicResource I18n.performance.system}">
                <TextBlock
                    x:Name="HardwareText"
                    Foreground="{DynamicResource TextMutedBrush}"
                    LineHeight="24"
                    TextWrapping="Wrap" />
            </controls:LauncherCard>
            <controls:LauncherCard
                Header="{DynamicResource I18n.performance.usage}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource I18n.performance.interval}" />
                        <ComboBox
                            x:Name="IntervalBox"
                            Grid.Column="1"
                            Style="{StaticResource FormComboBoxStyle}"
                            SelectionChanged="Interval_Changed" />
                    </Grid>
                    <TextBlock
                        x:Name="CpuText"
                        Margin="0,18,0,8" />
                    <controls:AnimatedSegmentBar
                        x:Name="CpuBar"
                        Height="8"
                        FirstBrush="{DynamicResource AccentBrush}"
                        SecondBrush="{DynamicResource InkRaisedBrush}" />
                    <TextBlock
                        x:Name="MemoryText"
                        Margin="0,18,0,8" />
                    <controls:AnimatedSegmentBar
                        x:Name="MemoryBar"
                        Height="8"
                        FirstBrush="{DynamicResource AccentBrush}"
                        SecondBrush="{DynamicResource InkRaisedBrush}" />
                    <TextBlock
                        x:Name="ProcessText"
                        Margin="0,18,0,0"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="DiskText"
                        Margin="0,12,0,0"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
