<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.More.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:local="clr-namespace:ErhioLab.Craft.Launcher.Views.More"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <controls:LauncherCard
                Margin="0,0,0,14"
                Header="{DynamicResource I18n.performance.systemTitle}"
                Icon="{x:Static icons:LauncherIcons.OperatingSystem}">
                <StackPanel>
                    <TextBlock
                        x:Name="SystemNameText"
                        Style="{StaticResource HardwareModelTextStyle}" />
                    <TextBlock
                        x:Name="SystemArchitectureText"
                        Margin="0,5,0,0"
                        Style="{StaticResource HardwareDetailTextStyle}" />
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                Margin="0,0,0,14"
                Icon="{x:Static icons:LauncherIcons.Processor}">
                <controls:LauncherCard.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{DynamicResource I18n.performance.processor}" />
                        <ComboBox
                            x:Name="IntervalBox"
                            Grid.Column="1"
                            Width="126"
                            Margin="12,0,0,0"
                            FontSize="12"
                            FontWeight="Normal"
                            ToolTip="{DynamicResource I18n.performance.interval}"
                            SelectionChanged="Interval_Changed"
                            Style="{StaticResource FormComboBoxStyle}" />
                    </Grid>
                </controls:LauncherCard.Header>
                <StackPanel>
                    <TextBlock
                        x:Name="CpuModelText"
                        Style="{StaticResource HardwareModelTextStyle}" />
                    <TextBlock
                        x:Name="CpuTopologyText"
                        Margin="0,5,0,0"
                        Style="{StaticResource HardwareDetailTextStyle}" />
                    <UniformGrid
                        Margin="0,16,0,14"
                        Columns="2">
                        <controls:MetricReadout
                            x:Name="CpuUsage"
                            Caption="{DynamicResource I18n.performance.totalUsage}" />
                        <controls:MetricReadout
                            x:Name="ProcessCpuUsage"
                            Caption="{DynamicResource I18n.performance.launcherUsage}" />
                    </UniformGrid>
                    <controls:AnimatedSegmentBar
                        x:Name="CpuBar"
                        Height="7"
                        FirstBrush="{DynamicResource AccentBrush}"
                        SecondBrush="{DynamicResource InkRaisedBrush}" />
                </StackPanel>
            </controls:LauncherCard>
            <controls:LauncherCard
                Margin="0,0,0,14"
                Header="{DynamicResource I18n.performance.memoryTitle}"
                Icon="{x:Static icons:LauncherIcons.Memory}">
                <StackPanel>
                    <TextBlock
                        x:Name="MemoryCapacityText"
                        Style="{StaticResource HardwareModelTextStyle}" />
                    <UniformGrid
                        Margin="0,16,0,14"
                        Columns="3">
                        <controls:MetricReadout
                            x:Name="MemoryUsed"
                            Caption="{DynamicResource I18n.performance.used}" />
                        <controls:MetricReadout
                            x:Name="MemoryAvailable"
                            Caption="{DynamicResource I18n.performance.available}" />
                        <controls:MetricReadout
                            x:Name="ProcessMemory"
                            Caption="{DynamicResource I18n.performance.launcherWorkingSet}" />
                    </UniformGrid>
                    <controls:AnimatedSegmentBar
                        x:Name="MemoryBar"
                        Height="7"
                        FirstBrush="{DynamicResource MemoryUsedBrush}"
                        SecondBrush="{DynamicResource MemoryFreeBrush}" />
                </StackPanel>
            </controls:LauncherCard>
            <ItemsControl
                x:Name="GraphicsCards">
                <ItemsControl.ItemTemplate>
                    <DataTemplate
                        DataType="{x:Type local:PerformancePage+GraphicsRow}">
                        <controls:LauncherCard
                            Margin="0,0,0,14"
                            Icon="{x:Static icons:LauncherIcons.Graphics}">
                            <controls:LauncherCard.Header>
                                <StackPanel
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}" />
                                    <Border
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style
                                                TargetType="Border"
                                                BasedOn="{StaticResource InfoBadgeStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding HasBadge}"
                                                        Value="False">
                                                        <Setter
                                                            Property="Visibility"
                                                            Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock
                                            Text="{Binding Badge}"
                                            Style="{StaticResource InfoBadgeTextStyle}" />
                                    </Border>
                                </StackPanel>
                            </controls:LauncherCard.Header>
                            <TextBlock
                                Text="{Binding Name}"
                                Style="{StaticResource HardwareModelTextStyle}" />
                        </controls:LauncherCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:LauncherCard
                Margin="0,0,0,14"
                Header="{DynamicResource I18n.performance.diskTitle}"
                Icon="{x:Static icons:LauncherIcons.Disk}">
                <StackPanel>
                    <TextBlock
                        x:Name="DiskNameText"
                        Style="{StaticResource HardwareModelTextStyle}" />
                    <TextBlock
                        x:Name="DiskPathText"
                        Margin="0,5,0,0"
                        Style="{StaticResource HardwareDetailTextStyle}" />
                    <UniformGrid
                        Margin="0,16,0,14"
                        Columns="3">
                        <controls:MetricReadout
                            x:Name="DiskUsed"
                            Caption="{DynamicResource I18n.performance.used}" />
                        <controls:MetricReadout
                            x:Name="DiskAvailable"
                            Caption="{DynamicResource I18n.performance.available}" />
                        <controls:MetricReadout
                            x:Name="DiskCapacity"
                            Caption="{DynamicResource I18n.performance.capacity}" />
                    </UniformGrid>
                    <controls:AnimatedSegmentBar
                        x:Name="DiskBar"
                        Height="7"
                        FirstBrush="{DynamicResource AccentBrush}"
                        SecondBrush="{DynamicResource InkRaisedBrush}" />
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
