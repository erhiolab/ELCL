<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.More.ToolboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    Background="{DynamicResource InkBrush}">
    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <controls:LauncherCard>
                <controls:LauncherCard.Header>
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{DynamicResource I18n.toolbox.customDownloadTitle}" />
                        <TextBlock
                            Margin="0,9,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="{DynamicResource I18n.toolbox.downloadDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:LauncherCard.Header>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,7"
                        FontSize="12"
                        Text="{DynamicResource I18n.toolbox.downloadUrl}" />
                    <TextBox
                        x:Name="DownloadUrlBox"
                        Style="{StaticResource FormTextBoxStyle}"
                        TextChanged="DownloadUrlBox_TextChanged" />

                    <TextBlock
                        Margin="0,16,0,7"
                        FontSize="12"
                        Text="{DynamicResource I18n.toolbox.saveTo}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="10" />
                            <ColumnDefinition
                                Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SaveFolderBox"
                            Style="{StaticResource FormTextBoxStyle}" />
                        <Button
                            Grid.Column="2"
                            Click="ChooseFolder_Click"
                            Content="{DynamicResource I18n.toolbox.chooseFolder}"
                            Style="{StaticResource SecondaryActionStyle}" />
                    </Grid>

                    <TextBlock
                        Margin="0,16,0,7"
                        FontSize="12"
                        Text="{DynamicResource I18n.toolbox.fileName}" />
                    <TextBox
                        x:Name="FileNameBox"
                        Style="{StaticResource FormTextBoxStyle}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="10"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{DynamicResource I18n.toolbox.fileNameHint}" />

                    <StackPanel
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="StartButton"
                            Width="132"
                            Height="42"
                            Click="StartDownload_Click"
                            Content="{DynamicResource I18n.common.startDownload}"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryActionStyle}" />
                        <Button
                            x:Name="OpenFolderButton"
                            Width="132"
                            Margin="10,0,0,0"
                            Click="OpenFolder_Click"
                            Content="{DynamicResource I18n.toolbox.openFolder}"
                            Style="{StaticResource SecondaryActionStyle}" />
                    </StackPanel>
                </StackPanel>
            </controls:LauncherCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
