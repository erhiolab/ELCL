<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.More.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ErhioLab.Craft.Launcher.Controls"
    xmlns:more="clr-namespace:ErhioLab.Craft.Launcher.Views.More"
    Background="{DynamicResource InkBrush}">
    <UserControl.Resources>
        <DataTemplate
            x:Key="CreditRowTemplate"
            DataType="{x:Type more:AboutPage+CreditEntry}">
            <Grid
                MinHeight="58"
                Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="42" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center">
                    <Ellipse
                        Fill="{DynamicResource AccentMutedBrush}" />
                    <Ellipse
                        x:Name="AvatarPhoto">
                        <Ellipse.Fill>
                            <ImageBrush
                                ImageSource="{Binding AvatarImage}"
                                Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock
                        x:Name="AvatarFallback"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="{DynamicResource CaptionFontSize}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentTextBrush}"
                        Text="{Binding AvatarText}"
                        Visibility="Collapsed" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    Margin="8,0,12,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="{DynamicResource BodyFontSize}"
                        FontWeight="Medium"
                        Text="{Binding Name}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="{DynamicResource CaptionFontSize}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="LinkButton"
                    Grid.Column="2"
                    Width="116"
                    Height="32"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Click="LinkButton_Click"
                    Content="{Binding ActionText}"
                    Style="{StaticResource CreditLinkButtonStyle}"
                    Tag="{Binding Url}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger
                    Binding="{Binding AvatarImage}"
                    Value="{x:Null}">
                    <Setter
                        TargetName="AvatarPhoto"
                        Property="Visibility"
                        Value="Collapsed" />
                    <Setter
                        TargetName="AvatarFallback"
                        Property="Visibility"
                        Value="Visible" />
                </DataTrigger>
                <DataTrigger
                    Binding="{Binding ActionText}"
                    Value="{x:Null}">
                    <Setter
                        TargetName="LinkButton"
                        Property="Visibility"
                        Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate
            x:Key="LicenseRowTemplate">
            <Grid
                MinHeight="56"
                Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding Name}"
                        FontSize="{DynamicResource BodyFontSize}"
                        FontWeight="Medium"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Text="{Binding Description}"
                        FontSize="{DynamicResource CaptionFontSize}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button
                        Width="92"
                        Height="32"
                        Margin="0,0,8,0"
                        Style="{StaticResource CreditLinkButtonStyle}"
                        Content="{DynamicResource I18n.about.viewSource}"
                        Tag="{Binding SourceUrl}"
                        Click="LinkButton_Click" />
                    <Button
                        Width="92"
                        Height="32"
                        Style="{StaticResource CreditLinkButtonStyle}"
                        Content="{DynamicResource I18n.about.viewLicense}"
                        ToolTip="{DynamicResource I18n.about.licenseLinkHint}"
                        Tag="{Binding LicenseUrl}"
                        Click="LinkButton_Click" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate
            x:Key="LicenseGroupTemplate">
            <StackPanel
                Margin="{StaticResource FormSectionSpacing}">
                <TextBlock
                    Text="{Binding Title}"
                    FontSize="{DynamicResource LabelFontSize}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentTextBrush}" />
                <ItemsControl
                    Margin="0,6,0,0"
                    ItemsSource="{Binding Entries}"
                    ItemTemplate="{StaticResource LicenseRowTemplate}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="{StaticResource FormPageContentMargin}">
            <Border
                Padding="18,14"
                Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource I18n.about.title}" />
                    <ItemsControl
                        x:Name="AboutEntries"
                        Margin="0,10,0,0"
                        ItemTemplate="{StaticResource CreditRowTemplate}" />
                </StackPanel>
            </Border>
            <Border
                Margin="0,14,0,0"
                Padding="18,14"
                Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource I18n.about.specialThanks}" />
                    <ItemsControl
                        x:Name="ThanksEntries"
                        Margin="0,10,0,0"
                        ItemTemplate="{StaticResource CreditRowTemplate}" />
                </StackPanel>
            </Border>
            <Border
                Margin="{StaticResource FormSectionSpacing}"
                Padding="0"
                Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <ToggleButton
                        x:Name="LicensesToggle"
                        IsChecked="False"
                        Content="{DynamicResource I18n.about.licensesTitle}"
                        Style="{StaticResource CardExpanderHeaderStyle}" />
                    <controls:AnimatedReveal
                        IsExpanded="{Binding IsChecked, ElementName=LicensesToggle}">
                        <StackPanel
                            Margin="20,0,20,20">
                            <Border
                                Height="1"
                                Margin="0,0,0,12"
                                Background="{DynamicResource LineSoftBrush}" />
                            <TextBlock
                                Text="{DynamicResource I18n.about.licensesDescription}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="{DynamicResource LabelFontSize}"
                                TextWrapping="Wrap" />
                            <ItemsControl
                                x:Name="LicenseGroups"
                                ItemTemplate="{StaticResource LicenseGroupTemplate}" />
                            <TextBlock
                                Margin="{StaticResource FormSectionSpacing}"
                                Text="{DynamicResource I18n.about.downloadedContentLicenses}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="{DynamicResource CaptionFontSize}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:AnimatedReveal>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
