<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.More.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource InkBrush}">
    <UserControl.Resources>
        <!-- 链接按钮的填充和边框使用同一层透明度缓动. -->
        <Style x:Key="CreditLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <Border
                                    Background="{DynamicResource AccentHoverBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Style="{StaticResource HoverLayerStyle}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 两张卡片共用的头像/名称/说明行, 按钮只在有链接时显示. -->
        <DataTemplate x:Key="CreditRowTemplate">
            <Grid MinHeight="58" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="34"
                    Height="34"
                    VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource AccentMutedBrush}" />
                    <Ellipse x:Name="AvatarPhoto">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock
                        x:Name="AvatarFallback"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentTextBrush}"
                        Text="{Binding AvatarText}"
                        Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding Name}" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="LinkButton"
                    Grid.Column="2"
                    Width="116"
                    Height="32"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Click="LinkButton_Click"
                    Content="{Binding ActionText}"
                    Style="{StaticResource CreditLinkButtonStyle}"
                    Tag="{Binding Url}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding AvatarImage}" Value="{x:Null}">
                    <Setter TargetName="AvatarPhoto" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="AvatarFallback" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionText}" Value="{x:Null}">
                    <Setter TargetName="LinkButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24,24,36">
            <Border
                Padding="18,14"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="9">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="关于" />
                    <ItemsControl
                        x:Name="AboutEntries"
                        Margin="0,10,0,0"
                        ItemTemplate="{StaticResource CreditRowTemplate}" />
                </StackPanel>
            </Border>
            <Border
                Margin="0,14,0,0"
                Padding="18,14"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="9">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="特别鸣谢" />
                    <ItemsControl
                        x:Name="ThanksEntries"
                        Margin="0,10,0,0"
                        ItemTemplate="{StaticResource CreditRowTemplate}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
