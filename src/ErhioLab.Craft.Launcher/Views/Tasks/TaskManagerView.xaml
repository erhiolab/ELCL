<UserControl
    x:Class="ErhioLab.Craft.Launcher.Views.Tasks.TaskManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:taskModels="clr-namespace:ErhioLab.Craft.Launcher.Tasks"
    Background="{DynamicResource InkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="200" />
            <ColumnDefinition
                Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{DynamicResource InkRaisedBrush}"
            BorderBrush="{DynamicResource LineSoftBrush}"
            BorderThickness="0,0,1,0">
            <StackPanel
                Margin="24,98,24,0">
                <TextBlock
                    x:Name="OverallProgressLabel"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource AccentBrush}"
                    Text="{DynamicResource I18n.taskManager.overallProgress}" />
                <ProgressBar
                    x:Name="OverallProgressBar"
                    Height="3"
                    Margin="0,8,0,7"
                    Maximum="100"
                    Foreground="{DynamicResource AccentBrush}" />
                <TextBlock
                    x:Name="OverallProgressText"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    Text="0%" />

                <TextBlock
                    Margin="0,82,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource AccentBrush}"
                    Text="{DynamicResource I18n.taskManager.downloadSpeed}" />
                <Border
                    Height="1"
                    Margin="0,8,0,7"
                    Background="{DynamicResource AccentBrush}" />
                <TextBlock
                    x:Name="SpeedText"
                    HorizontalAlignment="Center"
                    FontSize="19"
                    Text="0 KiB/s" />

                <TextBlock
                    Margin="0,82,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource AccentBrush}"
                    Text="{DynamicResource I18n.taskManager.remainingFiles}" />
                <Border
                    Height="1"
                    Margin="0,8,0,7"
                    Background="{DynamicResource AccentBrush}" />
                <TextBlock
                    x:Name="RemainingFilesText"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    Text="0" />
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Column="1"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Margin="24">
                <TextBlock
                    x:Name="EmptyText"
                    Margin="0,28,0,0"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="{DynamicResource TextMutedBrush}"
                    Text="{DynamicResource I18n.taskManager.noTasks}" />
                <ItemsControl
                    x:Name="TaskList"
                    ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate
                            DataType="{x:Type taskModels:LauncherTask}">
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Style="{StaticResource PanelCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition
                                                    Width="*" />
                                                <ColumnDefinition
                                                    Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Text="{Binding Title}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style
                                                        TargetType="TextBlock">
                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding StatusCode}"
                                                                Value="Running">
                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding StatusCode}"
                                                                Value="Completed">
                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="#46BF83" />
                                                            </DataTrigger>
                                                            <DataTrigger
                                                                Binding="{Binding StatusCode}"
                                                                Value="Failed">
                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="#E66B6B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock
                                            x:Name="TaskProgressText"
                                            Grid.Column="1"
                                            Margin="8,0,12,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Text="{Binding ProgressText}" />
                                        <Button
                                            Grid.Column="2"
                                            Width="54"
                                            Height="28"
                                            Margin="12,0,0,0"
                                            Click="TaskAction_Click"
                                            Content="{Binding ActionText}"
                                            IsEnabled="{Binding CanInvokeAction}"
                                            Style="{StaticResource SecondaryActionStyle}" />
                                    </Grid>
                                    <ProgressBar
                                        x:Name="TaskProgressBar"
                                        Height="3"
                                        Margin="0,12,0,9"
                                        Maximum="100"
                                        Value="{Binding Progress, Mode=OneWay}"
                                        Foreground="{DynamicResource AccentBrush}" />
                                    <ItemsControl
                                        x:Name="TaskStages"
                                        ItemsSource="{Binding Stages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate
                                                DataType="{x:Type taskModels:LauncherTaskStage}">
                                                <Grid
                                                    Margin="8,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
                                                            Width="42" />
                                                        <ColumnDefinition
                                                            Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Text="{Binding StatusText}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        Text="{Binding Name}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        x:Name="GameProcessText"
                                        Margin="0,10,0,0"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding ProcessText}"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="TaskErrorText"
                                        Margin="8,8,0,0"
                                        Foreground="#E66B6B"
                                        Text="{Binding Error}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsRunningGame}"
                                    Value="True">
                                    <Setter
                                        TargetName="TaskProgressText"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                    <Setter
                                        TargetName="TaskProgressBar"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                    <Setter
                                        TargetName="TaskStages"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                    <Setter
                                        TargetName="GameProcessText"
                                        Property="Visibility"
                                        Value="Visible" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding Error}"
                                    Value="{x:Null}">
                                    <Setter
                                        TargetName="TaskErrorText"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
