<Window
    x:Class="ErhioLab.Craft.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="ErhioLab Craft Launcher"
    Width="1120"
    Height="720"
    MinWidth="900"
    MinHeight="580"
    Background="{StaticResource InkBrush}"
    BorderThickness="0"
    FontFamily="{StaticResource TextFont}"
    Foreground="{StaticResource TextBrush}"
    ResizeMode="CanResize"
    SourceInitialized="Window_SourceInitialized"
    StateChanged="Window_StateChanged"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="10"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBar"
            Grid.Row="0"
            Background="{StaticResource InkRaisedBrush}"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource DisplayFont}"
                FontSize="15"
                FontWeight="Bold"
                Text="ELCL" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <RadioButton
                    x:Name="LaunchNavigation"
                    Content="启动"
                    GroupName="TopNavigation"
                    Tag="Launch"
                    Checked="PrimaryNavigation_Checked"
                    Style="{StaticResource TopNavigationStyle}" />
                <RadioButton
                    Content="下载"
                    GroupName="TopNavigation"
                    Tag="Download"
                    Checked="PrimaryNavigation_Checked"
                    Style="{StaticResource TopNavigationStyle}" />
                <RadioButton
                    Content="设置"
                    GroupName="TopNavigation"
                    Tag="Settings"
                    Checked="PrimaryNavigation_Checked"
                    Style="{StaticResource TopNavigationStyle}" />
                <RadioButton
                    Content="更多"
                    GroupName="TopNavigation"
                    Margin="0"
                    Tag="More"
                    Checked="PrimaryNavigation_Checked"
                    Style="{StaticResource TopNavigationStyle}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Click="MinimizeButton_Click"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="最小化">
                    <TextBlock
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Text="&#xE921;" />
                </Button>
                <Button
                    Click="MaximizeButton_Click"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="最大化/还原">
                    <TextBlock x:Name="MaximizeGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Text="&#xE922;" />
                </Button>
                <Button
                    Click="CloseButton_Click"
                    Style="{StaticResource CloseCaptionButtonStyle}"
                    ToolTip="关闭">
                    <TextBlock
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource InkRaisedBrush}"
                BorderBrush="{StaticResource LineSoftBrush}"
                BorderThickness="0,1,1,0">
                <ContentControl
                    x:Name="SidebarHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Border>

            <ContentControl
                x:Name="PageHost"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>