<Window
    x:Class="ErhioLab.Craft.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:ErhioLab.Craft.Launcher.Dialogs"
    xmlns:icons="clr-namespace:ErhioLab.Craft.Launcher.Icons"
    xmlns:launch="clr-namespace:ErhioLab.Craft.Launcher.Views.Launch"
    xmlns:notifications="clr-namespace:ErhioLab.Craft.Launcher.Notifications"
    xmlns:tasks="clr-namespace:ErhioLab.Craft.Launcher.Views.Tasks"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="ErhioLab Craft Launcher"
    Icon="Assets/Brand/ELCL.ico"
    Width="1120"
    Height="720"
    MinWidth="900"
    MinHeight="580"
    AllowsTransparency="True"
    Background="Transparent"
    BorderThickness="0"
    FontFamily="{StaticResource TextFont}"
    FontSize="{DynamicResource BodyFontSize}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    Foreground="{DynamicResource TextBrush}"
    ResizeMode="CanResize"
    SourceInitialized="Window_SourceInitialized"
    Loaded="Window_Loaded"
    StateChanged="Window_StateChanged"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="10"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid
        x:Name="ShellRoot">
        <Grid
            x:Name="WindowRoot"
            Background="{DynamicResource InkBrush}"
            SizeChanged="WindowRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="54" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏由应用绘制, 窗口按钮仍使用系统窗口命令. -->
            <Grid
                x:Name="TitleBar"
                Grid.Row="0"
                Background="{DynamicResource InkRaisedBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                MouseMove="TitleBar_MouseMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="180" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="150" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TitleBarLabel"
                    Grid.Column="0"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource DisplayFont}"
                    FontSize="15"
                    FontWeight="Bold"
                    TextTrimming="CharacterEllipsis"
                    Text="ELCL" />

                <StackPanel
                    x:Name="TaskTitle"
                    Grid.Column="0"
                    Margin="18,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Button
                        Width="30"
                        Height="30"
                        Click="CloseTaskManager_Click"
                        Style="{StaticResource SecondaryActionStyle}"
                        ToolTip="{DynamicResource I18n.common.back}">
                        <Path
                            Width="15"
                            Height="15"
                            Data="{x:Static icons:LauncherIcons.Back}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Stretch="Uniform" />
                    </Button>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource I18n.taskManager.title}" />
                </StackPanel>

                <StackPanel
                    x:Name="VersionSelectionTitle"
                    Grid.Column="0"
                    Margin="18,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Button
                        Width="30"
                        Height="30"
                        Click="CloseVersionSelection_Click"
                        Style="{StaticResource SecondaryActionStyle}"
                        ToolTip="{DynamicResource I18n.mainWindow.backToLaunch}">
                        <Path
                            Width="15"
                            Height="15"
                            Data="{x:Static icons:LauncherIcons.Back}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Stretch="Uniform" />
                    </Button>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource I18n.common.selectVersion}" />
                </StackPanel>

                <Grid
                    x:Name="VersionSettingsTitle"
                    Grid.Column="0"
                    Margin="18,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Width="30"
                        Height="30"
                        Click="CloseVersionSettings_Click"
                        ToolTip="{DynamicResource I18n.versionSettings.back}"
                        Style="{StaticResource SecondaryActionStyle}">
                        <Path
                            Width="15"
                            Height="15"
                            Data="{x:Static icons:LauncherIcons.Back}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Stretch="Uniform" />
                    </Button>
                    <TextBlock
                        x:Name="VersionSettingsTitleText"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <StackPanel
                    x:Name="AccountManagementTitle"
                    Grid.Column="0"
                    Margin="18,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <Button
                        Width="30"
                        Height="30"
                        Click="CloseAccountManagement_Click"
                        Style="{StaticResource SecondaryActionStyle}"
                        ToolTip="{DynamicResource I18n.mainWindow.backToLaunch}">
                        <Path
                            Width="15"
                            Height="15"
                            Data="{x:Static icons:LauncherIcons.Back}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Stretch="Uniform" />
                    </Button>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource I18n.mainWindow.accountManager}" />
                </StackPanel>

                <Grid
                    x:Name="TopNavigationHost"
                    Grid.Column="1"
                    SizeChanged="TopNavigationHost_SizeChanged">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <RadioButton
                            x:Name="LaunchNavigation"
                            GroupName="TopNavigation"
                            Tag="Launch"
                            Checked="PrimaryNavigation_Checked"
                            Style="{StaticResource TopNavigationStyle}">
                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <Path
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Data="{x:Static icons:LauncherIcons.Launch}"
                                    Fill="Transparent"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                    StrokeThickness="1.2"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    Stretch="Uniform" />
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.mainWindow.launch}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="DownloadNavigation"
                            GroupName="TopNavigation"
                            Tag="Download"
                            Checked="PrimaryNavigation_Checked"
                            Style="{StaticResource TopNavigationStyle}">
                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <Path
                                    VerticalAlignment="Center"
                                    Width="14"
                                    Height="14"
                                    Data="{x:Static icons:LauncherIcons.Download}"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    Stretch="Uniform" />
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.mainWindow.download}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            GroupName="TopNavigation"
                            Tag="Settings"
                            Checked="PrimaryNavigation_Checked"
                            Style="{StaticResource TopNavigationStyle}">
                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <Path
                                    VerticalAlignment="Center"
                                    Width="14"
                                    Height="14"
                                    Data="{x:Static icons:LauncherIcons.Settings}"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                                    StrokeThickness="1.5"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    Stretch="Uniform" />
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.mainWindow.settings}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            GroupName="TopNavigation"
                            Margin="0"
                            Tag="More"
                            Checked="PrimaryNavigation_Checked"
                            Style="{StaticResource TopNavigationStyle}">
                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <Path
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Data="{x:Static icons:LauncherIcons.More}"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                    StrokeThickness="1.5" />
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource I18n.mainWindow.more}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <Border
                        x:Name="NavigationIndicator"
                        Width="18"
                        Height="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource AccentBrush}"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform
                                x:Name="NavigationIndicatorOffset" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <StackPanel
                    x:Name="WindowControls"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Click="MinimizeButton_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="{DynamicResource I18n.mainWindow.minimize}">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{x:Static icons:LauncherIcons.Minimize}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        Click="MaximizeButton_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="{DynamicResource I18n.mainWindow.maximizeRestore}">
                        <Path
                            x:Name="MaximizeGlyph"
                            Width="10"
                            Height="10"
                            Data="{x:Static icons:LauncherIcons.Maximize}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Stretch="Uniform" />
                    </Button>
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="{DynamicResource I18n.mainWindow.close}">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{x:Static icons:LauncherIcons.Close}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 一级页面只替换侧栏和主体内容. -->
            <Grid
                Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        x:Name="SidebarColumn"
                        Width="310"
                        MinWidth="135" />
                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="{DynamicResource InkRaisedBrush}"
                    BorderBrush="{DynamicResource LineSoftBrush}"
                    BorderThickness="0,1,1,0">
                    <ContentControl
                        x:Name="SidebarHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
                </Border>

                <ContentControl
                    x:Name="PageHost"
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Grid>

            <!-- 任务管理覆盖当前页面, 返回后保留原页面与侧栏状态. -->
            <tasks:TaskManagerView
                x:Name="TaskManagerPage"
                Panel.ZIndex="1"
                Grid.Row="1"
                Visibility="Collapsed" />
            <launch:VersionSelectionView
                x:Name="VersionSelectionPage"
                Grid.Row="1"
                Visibility="Collapsed" />
            <launch:AccountManagementView
                x:Name="AccountManagementPage"
                Grid.Row="1"
                Visibility="Collapsed" />
            <launch:VersionSettingsView
                x:Name="VersionSettingsPage"
                Grid.Row="1"
                Visibility="Collapsed" />
            <!-- 主题切换时短暂保留旧画面, 随后淡出到新配色. -->
            <Image
                x:Name="ThemeTransitionImage"
                Panel.ZIndex="2"
                Grid.Row="0"
                Grid.RowSpan="2"
                IsHitTestVisible="False"
                Opacity="1"
                Stretch="Fill"
                Visibility="Collapsed" />
        </Grid>
        <Button
            x:Name="TaskManagerButton"
            Width="48"
            Height="48"
            Margin="0,0,18,18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="OpenTaskManager_Click"
            Style="{StaticResource FloatingTaskButtonStyle}"
            ToolTip="{DynamicResource I18n.taskManager.title}"
            Visibility="Collapsed">
            <Path
                Width="22"
                Height="22"
                Data="{x:Static icons:LauncherIcons.TaskList}"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.7"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round" />
        </Button>
        <!-- 左下角的非阻塞通知始终跟随主窗口. -->
        <notifications:ToastHostView
            x:Name="ToastHost" />
        <!-- 弹窗常驻可视树, 点击时直接显示, 不再创建新的顶层窗口. -->
        <dialogs:LauncherDialogView
            x:Name="DialogOverlay"
            Visibility="Collapsed" />
    </Grid>
</Window>
