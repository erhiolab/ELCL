<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ErhioLab.Craft.Launcher</AssemblyName>
    <RootNamespace>ErhioLab.Craft.Launcher</RootNamespace>
    <Version>0.0.1</Version>
    <ApplicationIcon>Assets/Brand/ELCL.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ErhioLab.Craft.Launcher.Core/ErhioLab.Craft.Launcher.Core.csproj" />
    <EmbeddedResource Include="Languages/**/*.json" />
    <EmbeddedResource Include="Assets/Launch/*.jar" />
    <Content Include="Assets/Launch/*.LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/Brand/ELCL.ico" />
    <Resource Include="Assets/Brand/ELCL.png" />
    <Resource Include="Assets/Credits/Pcl.png" />
    <Resource Include="Assets/Credits/PrismLauncher.png" />
    <Resource Include="Assets/Credits/Bmclapi.jpg" />
    <Resource Include="Assets/Credits/MinecraftWiki.png" />
  </ItemGroup>
</Project>

