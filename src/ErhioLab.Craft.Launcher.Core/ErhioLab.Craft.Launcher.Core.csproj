<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ErhioLab.Craft.Launcher.Core</AssemblyName>
    <RootNamespace>ErhioLab.Craft.Launcher.Core</RootNamespace>
    <Version>0.0.2</Version>
    <Description>Cross-platform core library for ErhioLab Craft Launcher.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Mods/Data/*.json.gz" />
    <Content Include="Mods/Data/NOTICE.md" CopyToOutputDirectory="PreserveNewest" TargetPath="ThirdParty/MCMod-Index-NOTICE.md" />
  </ItemGroup>
</Project>

